@code {
    private class AuthenticationStateView : ComponentBase
    {
        [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
        [Inject] private NavigationManager Nav { get; set; } = default!;

        protected override async Task OnInitializedAsync()
        {
            if (AuthStateTask is null)
                return;

            var state = await AuthStateTask;
            if (state.User.Identity?.IsAuthenticated != true)
            {
                var returnUrl = Nav.ToBaseRelativePath(Nav.Uri);
                Nav.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(string.IsNullOrWhiteSpace(returnUrl) ? "/home" : "/" + returnUrl)}", true);
            }
        }
        protected override void BuildRenderTree(RenderTreeBuilder builder)
        {
            // Si se llega a renderizar aquí y el usuario está autenticado,
            // significa que está autenticado pero no autorizado (policy/roles futuros).
            builder.OpenElement(0, "p");
            builder.AddContent(1, "No autorizado.");
            builder.CloseElement();
        }
    }
}
