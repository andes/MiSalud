@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms
@using SaludPortal.Web.Components.Icons
@typeparam TValue

<div class="input-field-group">
    <div class="input-group @(HasError ? "invalid" : "")">
        <div class="input-icon">
            <Icon Name="@IconName" Size="18" Fill="#666" AriaLabel="@AriaLabel" />
        </div>
        <input id="@Id"
               type="@Type"
               @bind="@CurrentValue"
               class="input-field"
               placeholder="@Placeholder"
               aria-label="@AriaLabel"
               disabled="@Disabled" />
    </div>
    <ValidationMessage For="@ValidationFor" class="validation-message" style="color: #dc3545;" />
</div>

@code {
    [Parameter] public string Id { get; set; } = "";
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public string IconName { get; set; } = "";
    [Parameter] public string Placeholder { get; set; } = "";
    [Parameter] public string AriaLabel { get; set; } = "";
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }
    [Parameter] public Expression<Func<TValue>>? ValidationFor { get; set; }
    [Parameter] public bool HasError { get; set; } = false;

    private TValue? CurrentValue
    {
        get => Value;
        set
        {
            if (!EqualityComparer<TValue>.Default.Equals(value, Value))
            {
                Value = value;
                ValueChanged.InvokeAsync(value);
            }
        }
    }
}
