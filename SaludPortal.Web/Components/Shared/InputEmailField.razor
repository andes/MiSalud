@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms
@using SaludPortal.Web.Components.Icons
@using System.Text.RegularExpressions

<div class="input-field-group">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="input-label">@Label</label>
    }
    <div class="input-group @(HasError ? "invalid" : "")">
        <div class="input-icon">
            <Icon Name="@IconName" Size="18" Fill="#666" AriaLabel="@AriaLabel" />
        </div>
        <input type="email"
               inputmode="email"
               class="input-field"
               placeholder="@Placeholder"
               @bind="EmailValue"
               @bind:event="oninput"
               maxlength="@MaxLength"
               disabled="@Disabled" />
    </div>
    <ValidationMessage For="@ValidationFor" class="validation-message" style="color: #dc3545;" />
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string IconName { get; set; } = "envelope";
    [Parameter] public string Placeholder { get; set; } = "";
    [Parameter] public string AriaLabel { get; set; } = "";
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public int MaxLength { get; set; } = 100;
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public Expression<Func<string>>? ValidationFor { get; set; }
    [Parameter] public bool HasError { get; set; } = false;

    private static readonly Regex EspaciosRegex = new Regex(@"\s", RegexOptions.Compiled);

    private string EmailValue
    {
        get => Value ?? "";
        set
        {
            string valor = EspaciosRegex.Replace(value ?? "", "").ToLowerInvariant();
            ValueChanged.InvokeAsync(valor);
        }
    }
}
