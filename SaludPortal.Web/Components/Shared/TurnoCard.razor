@using AndesServices.Entities
@using Microsoft.AspNetCore.Components
@using SaludPortal.Web.Components.Icons
@using SaludPortal.Web.Utils
@using System.Linq

<div class="turno-card" @onclick="HandleClick" tabindex="0">
    <div class="turno-header">
        <div class="turno-numero">#@Numero</div>
        @if (Turno.tipoPrestacion != null && !string.IsNullOrWhiteSpace(Turno.tipoPrestacion.term))
        {
            <span class="turno-tipo-badge">@Turno.tipoPrestacion.term</span>
        }
    </div>
    <div class="turno-body">
        <div class="turno-info-item">
            <span class="turno-label">Fecha turno:</span>
            <span class="turno-value">@GetFechaFormateada()</span>
        </div>

        @if (Turno.asistencia != null)
        {
            <div class="turno-asistencia">
                @if (Turno.asistencia == "noAsistio")
                {
                    <span class="turno-badge inasistencia">SIN DATOS DE ASISTENCIA</span>
                }
                else
                {
                    @if (Turno.horaAsistencia != null)
                    {
                        <span class="turno-badge asistencia">ASISTENCIA A LAS @Turno.horaAsistencia.Value.ToString("HH:mm") HS</span>
                    }
                    else
                    {
                        <span class="turno-badge asistencia">ASISTIÓ</span>
                    }
                }
            </div>
        }
        else
        {
            <div class="turno-asistencia">
                <span class="turno-badge inasistencia">SIN DATOS DE ASISTENCIA</span>
            </div>
        }

        @if (Turno.profesionales != null && Turno.profesionales.Any())
        {
            <div class="turno-profesionales">
                <div class="turno-label">
                    <Icon Name="person-vcard" Size="16" Fill="#666" class="me-1" AriaLabel="Profesional" />
                    Profesional:
                </div>
                <ul class="turno-profesionales-list">
                    @foreach (var profesional in Turno.profesionales)
                    {
                        <li>@profesional.apellido @profesional.nombre</li>
                    }
                </ul>
            </div>
        }

        @if (Turno.organizacion != null && !string.IsNullOrWhiteSpace(Turno.organizacion.nombre))
        {
            <div class="turno-info-item">
                <span class="turno-label">
                    <Icon Name="hospital" Size="16" Fill="#666" class="me-1" AriaLabel="Institución" />
                    Institución:
                </span>
                <span class="turno-value">@Turno.organizacion.nombre</span>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public MisTurnos Turno { get; set; } = new();

    [Parameter]
    public int Numero { get; set; }

    [Parameter]
    public EventCallback<MisTurnos> OnClick { get; set; }

    private string GetFechaFormateada()
    {
        var fecha = DateTimeHelper.ToArgentinaTime(Turno.horaInicio);
        return $"{Turno.horaInicio:dd/MM/yyyy} {fecha:HH:mm}";
    }

    private async Task HandleClick()
    {
        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync(Turno);
        }
    }
}
