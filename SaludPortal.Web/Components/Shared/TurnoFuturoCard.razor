@using AndesServices.Entities
@using Microsoft.AspNetCore.Components
@using SaludPortal.Web.Components.Icons
@using SaludPortal.Web.Utils

<div class="turno-futuro-card">
    <div class="turno-futuro-header">
        @if (Turno.tipoPrestacion != null && !string.IsNullOrWhiteSpace(Turno.tipoPrestacion.term))
        {
            <span class="turno-futuro-badge">@Turno.tipoPrestacion.term</span>
        }
        @if (EsTeleconsulta)
        {
            <span class="turno-futuro-tipo">Teleconsulta</span>
        }
    </div>
    <div class="turno-futuro-body">
        <div class="turno-futuro-info-item">
            <span class="turno-futuro-label">
                @if (EsTeleconsulta)
                {
                    <span>Fecha de solicitud:</span>
                }
                else
                {
                    <span>Fecha:</span>
                }
            </span>
            <span class="turno-futuro-value">@GetFechaFormateada()</span>
        </div>

        @if (!EsTeleconsulta && Turno.organizacion != null && !string.IsNullOrWhiteSpace(Turno.organizacion.nombre))
        {
            <div class="turno-futuro-info-item">
                <span class="turno-futuro-label">
                    <Icon Name="hospital" Size="16" Fill="#666" class="me-1" AriaLabel="Lugar" />
                    Lugar:
                </span>
                <span class="turno-futuro-value">@Turno.organizacion.nombre</span>
            </div>
        }
    </div>
    <div class="turno-futuro-footer">
        <button class="turno-futuro-cancel-button" @onclick="HandleCancel" @onclick:stopPropagation="true" title="Cancelar turno">
            <Icon Name="cancelar-turno" Size="20" Fill="#fff" AriaLabel="Cancelar" />
            <span>Cancelar</span>
        </button>
    </div>
</div>

@code {
    [Parameter]
    public MisTurnos Turno { get; set; } = new();

    [Parameter]
    public bool EsTeleconsulta { get; set; }

    [Parameter]
    public EventCallback<MisTurnos> OnCancel { get; set; }

    private string GetFechaFormateada()
    {
        if (EsTeleconsulta)
        {
            return Turno.horaInicio.ToString("dd/MM/yyyy");
        }
        else
        {
            var fecha = DateTimeHelper.ToArgentinaTime(Turno.horaInicio);
            return $"{Turno.horaInicio:dd/MM/yyyy} {fecha:HH:mm}";
        }
    }

    private async Task HandleCancel()
    {
        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync(Turno);
        }
    }
}
