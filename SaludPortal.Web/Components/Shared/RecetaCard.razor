@using AndesServices.Entities
@using Microsoft.AspNetCore.Components

<div class="receta-card">
    <div class="receta-header">
        <span class="receta-fecha">@Receta.fechaRegistro.ToString("dd/MM/yyyy HH:mm:ss")</span>
        <span class="receta-estado @GetEstadoDispensaClass()">@GetEstadoDispensaTexto()</span>
    </div>
    
    <div class="receta-body">
        @if (Receta.profesional != null)
        {
            <div class="receta-section">
                <h4 class="receta-section-title">Profesional</h4>
                <div class="receta-info">
                    <span class="receta-label">Nombre:</span>
                    <span class="receta-value">@Receta.profesional.apellido @Receta.profesional.nombre</span>
                </div>
                <div class="receta-info">
                    <span class="receta-label">MÉDICA - MP:</span>
                    <span class="receta-value">@(Receta.profesional.matricula.HasValue ? Receta.profesional.matricula.Value.ToString() : "-")</span>
                </div>
                <div class="receta-info">
                    <span class="receta-label">Especialidad:</span>
                    <span class="receta-value">@(Receta.profesional.especialidad == null || Receta.profesional.especialidad.Length == 0 ? "-" : Receta.profesional.especialidad)</span>
                </div>
            </div>
        }

        @if (Receta.medicamento != null)
        {
            <div class="receta-section">
                <h4 class="receta-section-title">Medicamento</h4>
                <div class="receta-medicamento-table">
                    <div class="receta-medicamento-row">
                        <div class="receta-medicamento-label">Medicamento:</div>
                        <div class="receta-medicamento-value">@Receta.medicamento.concepto.term</div>
                    </div>
                    <div class="receta-medicamento-row">
                        <div class="receta-medicamento-label">Cantidad:</div>
                        <div class="receta-medicamento-value">@Receta.medicamento.cantEnvases envase(s) de @Receta.medicamento.cantidad @Receta.medicamento.presentacion</div>
                    </div>
                </div>
            </div>
        }

        @if (Receta.diagnostico != null && !string.IsNullOrWhiteSpace(Receta.diagnostico.term))
        {
            <div class="receta-section">
                <h4 class="receta-section-title">Diagnóstico</h4>
                <div class="receta-info">
                    <span class="receta-value">@Receta.diagnostico.term</span>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public MisReceta Receta { get; set; } = new();

    private string GetEstadoDispensaTexto()
    {
        if (EsVencidaPorAntiguedad())
            return "vencida";

        if (string.IsNullOrWhiteSpace(Receta.estadoDispensaActual?.tipo))
            return "sin-dispensa";

        return Receta.estadoDispensaActual.tipo;
    }

    private string GetEstadoDispensaClass()
    {
        var estadoTipo = GetEstadoDispensaTexto();
        var normalizado = estadoTipo.Trim().ToLowerInvariant().Replace("_", "-").Replace(" ", "-");

        if (normalizado.Contains("sin-dispens"))
            return "receta-estado--sin-dispensa";

        if (normalizado.Contains("venc"))
            return "receta-estado--vencida";

        if (normalizado.Contains("dispens"))
            return "receta-estado--dispensada";

        return "receta-estado--sin-dispensa";
    }

    private bool EsVencidaPorAntiguedad()
    {
        var estadoTipo = Receta.estadoDispensaActual?.tipo;
        var normalizado = (estadoTipo ?? string.Empty).Trim().ToLowerInvariant().Replace("_", "-").Replace(" ", "-");

        var estaDispensada = normalizado.Contains("dispens") && !normalizado.Contains("sin-dispens");
        if (estaDispensada)
            return false;

        var fechaBase = Receta.fechaRegistro != default
            ? Receta.fechaRegistro
            : Receta.fechaPrestacion;

        if (fechaBase == default)
            return false;

        return fechaBase.AddDays(30) < DateTime.Now;
    }
}
