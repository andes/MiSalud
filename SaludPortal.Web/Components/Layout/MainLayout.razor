@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@fortawesome/fontawesome-free@6.7.2/css/fontawesome.min.css">
<Title>Salud Neuquén - Portal Paciente</Title>
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <div class="top-row title">
                Portal de Salud - Neuquén
            </div>
            <div class="logo-container">
                <img src="../images/gobierno-neuquen.svg" alt="Logo Gobierno de la Provincia del Neuquén">
                <img src="../images/neuquen-logo.svg" alt="logo Provincia del Neuquén">
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
<Spinner Icon="loadingSalud.svg" Type="@SpinnerType.Icon" Text="Cargando..."></Spinner>
<div id="blazor-error-ui">
    Se produjo un error no manejado.
    <a href="" class="reload">Recargar</a>
    <a class="dismiss">🗙</a>
</div>
<script src="https://cdn.jsdelivr.net/npm/@@fortawesome/fontawesome-free@6.7.2/js/all.min.js"></script>