@page "/historiasalud/{expresionSnomed}/"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using SaludPortal.Web.Components.Icons
@using SaludPortal.Web.Components.Shared
@using SaludPortal.Web.Components.Modals
@using SaludPortal.Web.Services
@using AndesServices.Interfaces
@using AndesServices.Entities.ViewModels
@using AndesServices.Entities
@using System.Text.Json
@using System.Linq

@inject IHttpClientFactory HttpClientFactory
@inject BlazorSpinner.SpinnerService _spinnerService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inherits AuthenticatedComponentBase
@inject IHistoriaSalud _miHistoriaSaludService

<PageTitle>@($"Historia de salud - {categoriaSeleccionada?.Titulo} - Mi Salud")</PageTitle>

<div class="prestaciones-container">
    <div class="prestaciones-header">
        <PageHeader Title="@categoriaSeleccionada?.Titulo" Subtitle="Historial de prestaciones médicas" />
        <div class="prestaciones-header__back">
            <ButtonPrimaryOutlined Href="/historiasalud"
                                   Text="VOLVER"
                                   AriaLabel="Volver a Historia de Salud"
                                   Size="sm" />
        </div>
    </div>

    @if (cargando)
    {
        <div class="text-center my-4">
            <p>Cargando...</p>
        </div>
    }
    else if (error != null)
    {
        <div class="alert alert-danger">@error</div>
    }
    else if (prestaciones == null || prestaciones.Count == 0)
    {
        <EmptyState Message="No se encontraron prestaciones." />
    }
    else
    {
        <div class="prestaciones-section">
            <SectionTitle Title="Prestaciones" Icon="bi bi-clipboard2-heart" />
            <div class="prestaciones-grid">
                @foreach (var p in prestaciones.OrderByDescending(p => p.ejecucion?.fecha))
                {
                    if (p.EsCda())
                    {
                        <HistorialCdaCard Prestacion="p" OnDownload="DownloadPdfPrestacion" />                    
                    } 
                    else if (p.EsEcocardiograma())
                    {
                        <HistorialPrestacionEcocardiogramaCard Prestacion="p" OnDownload="DownloadPdfPrestacion" />
                    } 
                    else {
                        <HistorialPrestacionCard Prestacion="p" OnDownload="DownloadPdfPrestacion"
                                                 OnViewImage="@(_fileToken != null ? OpenImagenPrestacion : default)"
                                                 OnCopyLink="@(_fileToken != null ? CopiarEnlacePrestacion : default)"
                                                 LinkCopied="@(_copiedPrestacionId == p.id)" />
                    }
                }
            </div>
        </div>
    }

</div>

<script type="text/javascript">

    function openPdf(archivo, categoria) {
        const pdfData = "data:application/pdf;base64," + archivo;

        const a = document.createElement("a");
        document.body.appendChild(a);
        a.href = pdfData;
        a.download = "prestacion_" + categoria + ".pdf";
        a.target = "_self";
        a.click();
    }
</script>

@code {
    [CascadingParameter] IModalService Modal { get; set; } = default!;

    [Parameter] public string? expresionSnomed { get; set; }

    private CategoriaHistoriaSalud? categoriaSeleccionada;
    private List<PrestacionHistoriaSalud>? prestaciones;
    private bool cargando;
    private string? error;
    private string? _fileToken;
    private string? _copiedPrestacionId;
    private CancellationTokenSource? _copiedResetCts;

    protected override async Task OnAuthenticatedInitializedAsync()
    {
        var token = BackendToken;
        if (string.IsNullOrEmpty(token))
            return;

        var pacienteId = PacienteId;
        if (string.IsNullOrEmpty(pacienteId))
            return;

        if (string.IsNullOrWhiteSpace(expresionSnomed))
        {
            error = "Tipo categoría inválida.";
            return;
        }

        try
        {
            _spinnerService.Show();
            prestaciones = await _miHistoriaSaludService.ObtenerPrestacionesAsync(expresionSnomed, pacienteId);
            _fileToken = await _miHistoriaSaludService.ObtenerFileTokenAsync();
            categoriaSeleccionada = (await _miHistoriaSaludService.ObtenerCategoriasHistoriaSaludAsync(expresionSnomed))
                .FirstOrDefault();
        }
        catch (Exception ex)
        {
            error = "Error obteniendo prestaciones: " + ex.Message;
        }
        finally
        {
            _spinnerService.Hide();
        }
    }

    async Task DownloadPdfPrestacion(PrestacionHistoriaSalud prestacion)
    {
        string idPrestacion = prestacion?.id ?? "";
        var categoria = categoriaSeleccionada?.Titulo ?? "prestacion";
  
        _spinnerService.Show();

        if (prestacion.EsCda())
        {
            if (prestacion.paciente?.adjuntos != null
                && prestacion.paciente.adjuntos.Count > 0
                && !string.IsNullOrEmpty(prestacion.paciente.adjuntos[0]))
            {
                var adjunto = prestacion.paciente.adjuntos[0];
                idPrestacion = adjunto.Substring(adjunto.LastIndexOf('/') + 1, adjunto.LastIndexOf('.') - adjunto.LastIndexOf('/') - 1);
            }
            var token = BackendToken;
            Byte[] archivoDescargar = await _miHistoriaSaludService.DescargarCDAFilePorIdAsync(idPrestacion);
            if (archivoDescargar == null || archivoDescargar.Length == 0)
            {
                _spinnerService.Hide();
                MostrarError("No se encontró el archivo de la prestación.");
                return;
            }

            string base64Pdf = Convert.ToBase64String(archivoDescargar);
            await JSRuntime.InvokeVoidAsync("openPdf", base64Pdf, categoria);
        }
        else
        {
            var pdfPrestacion = await _miHistoriaSaludService.DescargarPdfPrestacionAsync(idPrestacion);
            if (pdfPrestacion == null || pdfPrestacion.Length == 0)
            {
                _spinnerService.Hide();
                MostrarError("No se encontró el archivo de la prestación.");
                return;
            }
            else
            {
                string base64Pdf = Convert.ToBase64String(pdfPrestacion);
                await JSRuntime.InvokeVoidAsync("openPdf", base64Pdf, categoria);
            }
        }
        _spinnerService.Hide();
    }

    private void Volver()
    {
        NavigationManager.NavigateTo("/historiasalud");
    }

    private void MostrarError(string mensaje)
    {
        var parameters = new ModalParameters()
            .Add(nameof(ErrorModal.Titulo), "Error")
            .Add(nameof(ErrorModal.Mensaje), mensaje);
        var options = new ModalOptions()
        {
            Size = ModalSize.Medium,
            Position = ModalPosition.TopCenter,
            HideCloseButton = false,
            HideHeader = false
        };
        Modal.Show<ErrorModal>(parameters, options);
    }

    async Task OpenImagenPrestacion(PrestacionHistoriaSalud prestacion)
    {
        var idPrestacion = prestacion?.id ?? "";
        if (string.IsNullOrEmpty(idPrestacion))
        {
            MostrarError("No se encontró el identificador de la prestación.");
            return;
        }

        try
        {
            _spinnerService.Show();
            var url = await _miHistoriaSaludService.ObtenerImagenPrestacionUrlAsync(idPrestacion, _fileToken!);
            if (string.IsNullOrEmpty(url))
            {
                MostrarError("No se encontró imagen para esta prestación.");
                return;
            }
            await JSRuntime.InvokeVoidAsync("open", url, "_blank");
        }
        catch (Exception ex)
        {
            MostrarError("Error al obtener la imagen: " + ex.Message);
        }
        finally
        {
            _spinnerService.Hide();
        }
    }

    async Task CopiarEnlacePrestacion(PrestacionHistoriaSalud prestacion)
    {
        var idPrestacion = prestacion?.id ?? "";
        if (string.IsNullOrEmpty(idPrestacion))
        {
            MostrarError("No se encontró el identificador de la prestación.");
            return;
        }

        string? url = null;
        
        try
        {
            _spinnerService.Show();
            url = await _miHistoriaSaludService.ObtenerImagenPrestacionUrlAsync(idPrestacion, _fileToken!);
            if (string.IsNullOrEmpty(url))
            {
                MostrarError("No se encontró imagen para esta prestación.");
                return;
            }
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", url);
        }
        catch (OperationCanceledException)
        {
            // reset cancelado por nueva copia, no hacer nada
        }
        catch (Exception ex)
        {
            MostrarError("Error al copiar el enlace: " + ex.Message);
        }
        finally
        {
            _spinnerService.Hide();
        }

        if (!string.IsNullOrEmpty(url))
        {
            _copiedResetCts?.Cancel();
            _copiedResetCts = new CancellationTokenSource();
            _copiedPrestacionId = idPrestacion;
            StateHasChanged();

            var cts = _copiedResetCts;
            await Task.Delay(5000, cts.Token).ContinueWith(t =>
            {
                if (!t.IsCanceled)
                {
                    _copiedPrestacionId = null;
                    InvokeAsync(StateHasChanged);
                }
            });
        }
    }
}