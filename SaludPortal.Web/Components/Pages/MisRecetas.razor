@page "/misrecetas"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Authorization
@using SaludPortal.Web.Components.Shared
@using SaludPortal.Web.Services
@using AndesServices.Interfaces
@using AndesServices.Entities
@using System.Linq

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject BlazorSpinner.SpinnerService _spinnerService
@inject IMisRecetas _recetasService

@inherits AuthenticatedComponentBase

<PageTitle>Mis recetas - Mi Salud</PageTitle>

<div class="recetas-container">
    <PageHeaderWithBack Title="Mis Recetas"
                        Subtitle="Historial de recetas médicas"
                        BackHref="/historiasalud"
                        BackAriaLabel="Volver al historial de salud" />

    @if (lstRecetas != null && lstRecetas.Any())
    {
        <div class="recetas-section">
            <SectionTitle Title="Recetas Médicas" Icon="bi bi-file-medical" />
            <div class="recetas-grid">
                @foreach (var receta in lstRecetas.OrderByDescending(r => r.fechaRegistro))
                {
                    <RecetaCard Receta="receta" />
                }
            </div>
        </div>
    }
    else
    {
        <EmptyState Message="No se encontraron recetas registradas." />
    }
</div>

@code {
    private List<AndesServices.Entities.MisReceta> lstRecetas = new List<AndesServices.Entities.MisReceta>();

    protected override async Task OnAuthenticatedInitializedAsync()
    {
        var token = BackendToken;
        if (string.IsNullOrEmpty(token))
            return;

        _spinnerService.Show();
        lstRecetas = await _recetasService.ObtenerRecetasPacienteAsync(PacienteId);
        _spinnerService.Hide();
    }
}
