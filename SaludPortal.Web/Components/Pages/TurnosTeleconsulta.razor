@page "/turnosteleconsulta"
@page "/turnostelesalud"

@using Microsoft.AspNetCore.Components.Authorization
@using SaludPortal.Web.Components.Modals
@using SaludPortal.Web.Components.Shared
@using SaludPortal.Web.Services
@using System.Security.Claims
@using AndesServices.Entities

@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject BlazorSpinner.SpinnerService _spinnerService
@inject SaludPortal.Web.Services.PacienteService _unPacienteService
@inject SaludPortal.Web.Services.MisTurnosService _misTurnosService
@inject SaludPortal.Web.Services.OrganizacionService _organizacionService

@inherits AuthenticatedComponentBase

<h1>Telesalud</h1>
<hr />

@if (!consentimientoAceptado)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5);--bs-modal-width:850px;" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Consentimiento de Telesalud</h5>
                </div>
                <div class="modal-body">
                    <p><strong>Al seleccionar Telesalud Ud. está accediendo a un espacio en constante evolución.</strong></p>
                    <p><strong>La información con respecto a su salud es información sensible que está protegida por la Ley Provincial de Derechos de los Pacientes 2611 y la Ley Nacional de protección de datos personales 23.526.</strong></p>
                    <hr />
                    <p><strong>Importante:</strong></p>
                    <p>NO es un canal de resolución de urgencias ni emergencias médicas.</p>
                    <p>NO reemplaza la atención presencial.</p>
                    <hr />
                    <p>Ud. va a ser contactado al número de teléfono que indique por personal de Gestión de Pacientes, que le solicitará información adicional que puede ser necesaria para resolver su consulta en un plazo estimado de 24-48 horas.</p>
                    <p>Una vez que Ud. completó los datos solicitados podrá visualizar en el Portal Mi Salud: “solicitud de telesalud realizada”, y podrá cancelarla en cualquier momento. </p>
                    <p>Su consulta podrá ser resuelta vía contacto de personal de salud que tendrá acceso a su Historia Clínica. De corresponder receta o certificado podrá visualizarlos una vez emitido en <strong>Portal Mi Salud</strong>. De ser necesario ampliar la evaluación se le podrá asignar un turno presencial en caso de ser necesario o un turno para videoconsulta con un profesional.</p>
                    <p><span style="color:red;">Su consulta puede ser rechazada, y se le informará el motivo.</span></p>


                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="RechazarConsentimiento">
                        <i class="fa fa-times" aria-hidden="true"></i> Rechazar
                    </button>
                    <button type="button" class="btn btn-success" @onclick="AceptarConsentimiento">
                        <i class="fa fa-check" aria-hidden="true"></i> Aceptar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (consentimientoAceptado)
{
    <h2>Agendas disponibles para telesalud</h2>
    
    <div class="alert alert-info" role="alert">
        <i class="fa fa-info-circle" aria-hidden="true"></i>
        <strong>Importante:</strong> Solo puede tener un turno de telesalud asignado.
    </div>

    @if (lstAgendas != null && lstAgendas.Count > 0)
    {
        var tipoPrestacionIndex = 0;
        <div class="accordion" id="accAgendas">
            @foreach (var tipoPrestaciones in ObtenerTipoPrestacionesDisponibles())
            {
                var tipoId = $"TipoPrestacion_{tipoPrestacionIndex}";
                var collapseTipoId = $"collapse_{tipoPrestacionIndex}";
                var accOrgId = $"accOrganizaciones_{tipoPrestacionIndex}";
                var organizacionIndex = 0;
                <div class="accordion-item">
                    <h2 class="accordion-header" id="@tipoId">
                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseTipoId" aria-expanded="true" aria-controls="@collapseTipoId">
                            @tipoPrestaciones.term
                        </button>
                    </h2>
                    <div id="@collapseTipoId" class="accordion-collapse collapse show" aria-labelledby="@tipoId" data-bs-parent="#accAgendas">
                        <div class="accordion-body">
                            <div class="accordion" id="@accOrgId">
                                @foreach (var efectores in ObtenerEfectores(tipoPrestaciones.id))
                                {
                                    var (primerTurnoDisponible, bloqueId) = ObtenerPrimerTurnoDisponible(tipoPrestaciones.id, efectores.Efector._id);
                                    
                                    var orgId = $"Organizacion_{tipoPrestacionIndex}_{organizacionIndex}";
                                    var collapseOrgId = $"collapseOrg_{tipoPrestacionIndex}_{organizacionIndex}";
                                    <div class="accordion-item">
                                        <h2 class="accordion-header" id="@orgId">
                                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseOrgId" aria-expanded="true" aria-controls="@collapseOrgId">
                                                <div>
                                                    <i class="fa fa-video-camera" aria-hidden="true" style="max-width:16px;"></i> @efectores.Efector.nombre
                                                    <br />
                                                    <span class="badge bg-success">Telesalud</span>
                                                </div>
                                            </button>
                                        </h2>
                                        <div id="@collapseOrgId" class="accordion-collapse collapse show" aria-labelledby="@orgId" data-bs-parent="#@accOrgId">
                                            <div class="accordion-body">
                                                @if (primerTurnoDisponible != null && bloqueId != null)
                                                {
                                                    <div style="margin-bottom: 10px;">
                                                        <button class="btn btn-success" title="Seleccionar"
                                                                @onclick="() => ShowModalConfirmar(
                                                                    primerTurnoDisponible.horaInicio.Date, 
                                                                    DateTimeHelper.ToArgentinaTime(primerTurnoDisponible.horaInicio), 
                                                                    tipoPrestaciones.term, 
                                                                    efectores.Efector.nombre, 
                                                                    efectores.Domicilio, 
                                                                    tipoPrestaciones.id, 
                                                                    primerTurnoDisponible._id, 
                                                                    bloqueId)"
                                                        >
                                                            <i class="fa fa-video-camera" aria-hidden="true" style="max-width:16px;"></i> Solicitar atención
                                                        </button>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <hr />
                                    organizacionIndex++;
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <hr />
                tipoPrestacionIndex++;
            }
        </div>
    }
    else
    {
        <p>No hay turnos de telesalud disponibles.</p>
    }
}

@code {
    private bool consentimientoAceptado = false;
    private List<OrganizacionAgenda> lstAgendas = new List<OrganizacionAgenda>();
    private Paciente? _unPaciente = new Paciente();
    private Direccion _direccionGeoreferencia = new Direccion();
    private userLocation _userLocation = new userLocation();
    private int itemForeachtipoPrestaciones;
    private int itemForeachOrganizaciones;
    private Organizacion organizacion = new Organizacion();
    private Dictionary<string, string> _domiciliosOrganizaciones = new();
    private List<MisTurnos> lstMisTurnos = new List<MisTurnos>();
    private const string conceptIdTeleconsulta = "6421000013106";

    [CascadingParameter] IModalService Modal { get; set; } = default!;

    private void AceptarConsentimiento()
    {
        consentimientoAceptado = true;
        StateHasChanged();
    }

    private void RechazarConsentimiento()
    {
        Nav.NavigateTo("/misturnos", forceLoad: true);
    }

    private async Task ShowModalConfirmar(
        DateTime Fecha, 
        DateTime Hora, 
        string TipoPrestacion, 
        string Efector, 
        string EfectorDomicilio, 
        string IdTipoPrestacion, 
        string IdTurno, 
        string IdBloque)
    {
        // Verificar si ya tiene un turno de telesalud con fecha mayor a hoy
        if (lstMisTurnos != null && lstMisTurnos.Any())
        {
            var turnoFuturo = lstMisTurnos.FirstOrDefault(t => 
                DateTimeHelper.ToArgentinaTime(t.horaInicio).Date > DateTimeHelper.NowArgentina().Date && 
                t.tipoPrestacion != null &&
                t.tipoPrestacion.conceptId == conceptIdTeleconsulta &&
                (t.estado == "programado" || t.estado == "asignado" || t.estado == "pendiente"));

            if (turnoFuturo != null)
            {
                // Obtener información del turno
                var efectorNombre = turnoFuturo.organizacion?.nombre ?? "No especificado";
                var fechaTurno = DateTimeHelper.ToArgentinaTime(turnoFuturo.horaInicio).Date.ToString("dd/MM/yyyy");
                
                // Mostrar modal de error
                var errorOptions = new ModalOptions()
                {
                    Size = ModalSize.Medium,
                    Position = ModalPosition.TopCenter,
                    HideCloseButton = false,
                    HideHeader = false
                };

                var errorParameters = new ModalParameters()
                    .Add(nameof(ErrorModal.Titulo), 
                        "No se puede solicitar el turno")
                    .Add(nameof(ErrorModal.Mensaje), 
                        $"Ya tiene un turno de telesalud asignado. Efector: {efectorNombre}, Fecha: {fechaTurno}");

                Modal.Show<ErrorModal>(errorParameters, errorOptions);
                return;
            }
        }

        var options = new ModalOptions()
        {
            Size = ModalSize.Large,
            Position = ModalPosition.TopCenter,
            HideCloseButton = true,
            HideHeader = true
        };

        string Paciente = _unPaciente.nombre + " " + _unPaciente.apellido;

        var parameters = new ModalParameters()
        .Add(nameof(TurnoNuevoTeleconsultaConfirmar.Paciente), Paciente)
        .Add(nameof(TurnoNuevoTeleconsultaConfirmar.FechaTurno), Fecha.ToString("dd/MM/yyyy"))
        .Add(nameof(TurnoNuevoTeleconsultaConfirmar.TipoPrestacion), TipoPrestacion)
        .Add(nameof(TurnoNuevoTeleconsultaConfirmar.EfectorNombre), Efector)
        .Add(nameof(TurnoNuevoTeleconsultaConfirmar.EfectorDomicilio), EfectorDomicilio)
        .Add(nameof(TurnoNuevoTeleconsultaConfirmar.IdTurno), IdTurno)
        .Add(nameof(TurnoNuevoTeleconsultaConfirmar.IdBloque), IdBloque)
        .Add(nameof(TurnoNuevoTeleconsultaConfirmar.IdAgenda), ObtenerAgendaPorIdBloque(IdBloque)._id)
        .Add(nameof(TurnoNuevoTeleconsultaConfirmar._unTipoPrestacion), ObtenerTipoPrestacionesDisponibles(IdTipoPrestacion));

        Modal.Show<TurnoNuevoTeleconsultaConfirmar>(parameters, options);
    }

    protected override async Task OnAuthenticatedInitializedAsync()
    {
        var token = BackendToken;
        if (string.IsNullOrEmpty(token))
            return;

        var pacienteId = PacienteId;
        if (string.IsNullOrEmpty(pacienteId))
            return;

        _spinnerService.Show();

        try
        {
            // Obtengo el paciente
            _unPaciente = await _unPacienteService.ObtenerPacientePorIdAsync(token, pacienteId);

            // Verifico que domicilio utilizar para referencia a las organizaciones
            if (_unPaciente != null)
            {
                if (_unPaciente?.direccion?.Count() > 1)
                {
                    _direccionGeoreferencia = _unPaciente?.direccion[1];
                }
                else
                {
                    if (_unPaciente?.direccion?.Count() == 1) _direccionGeoreferencia = _unPaciente?.direccion[0];
                }
            }
            if (_direccionGeoreferencia == null) return;

            if (_direccionGeoreferencia.valor == null || _direccionGeoreferencia.ubicacion.localidad == null || _direccionGeoreferencia.ubicacion.provincia == null)
            {
                return;
            }
            string direccion = _direccionGeoreferencia.valor + ", " + _direccionGeoreferencia.ubicacion.localidad.nombre + ", " + _direccionGeoreferencia.ubicacion.provincia.nombre;
            _userLocation = await _unPacienteService.ObtenerGeoreferenciaPacienteAsync(direccion);

            if (_userLocation != null)
            {
                // Obtener los turnos del paciente para validar si ya tiene uno con fecha mayor a hoy
                lstMisTurnos = await _misTurnosService.ObtenerMisTurnosAsync(token) ?? new List<MisTurnos>();

                // La diferencia principal: esTeleconsulta: true
                lstAgendas = await _misTurnosService.ObtenerAgendasOrganizaciones(token, pacienteId, _userLocation, esTeleconsulta: true);

                // Obtener todos los IDs de organizaciones únicos
                var orgIds = lstAgendas
                    .SelectMany(e => e.agendas)
                    .Select(a => a.organizacion._id)
                    .Distinct()
                    .ToList();

                // Llamar a ObtenerOrganizacionPorIdAsync para cada organización y guardar el domicilio
                foreach (var orgId in orgIds)
                {
                    var organizacion = await _organizacionService.ObtenerOrganizacionPorIdAsync(token, orgId);
                    if (organizacion != null && !_domiciliosOrganizaciones.ContainsKey(orgId))
                    {
                        // Asume que organizacion.direccion?.valor es el domicilio
                        _domiciliosOrganizaciones[orgId] = organizacion.direccion?.valor ?? "";
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _spinnerService.Hide();
        }
    }

    private IEnumerable<(string term, string id)> ObtenerTipoPrestacionesDisponibles()
    {
        return lstAgendas?
        .SelectMany(e => e.agendas)
        .Where(a => a.bloques != null && a.bloques.Count > 0 && a.bloques.Any(b => b.restantesMobile > 0))
        .SelectMany(a => (a.tipoPrestaciones ?? new List<TipoPrestacion>()))
        .Where(tp => !string.IsNullOrWhiteSpace(tp.term))
        .Select(tp => (term: tp.term, id: tp._id))
        .Distinct()
        .OrderBy(t => t)
        ?? Enumerable.Empty<(string, string)>();
    }

    private TipoPrestacion? ObtenerTipoPrestacionesDisponibles(string id)
    {
        return lstAgendas?
            .SelectMany(e => e.agendas)
            .Where(a => a.bloques != null && a.bloques.Count > 0 && a.bloques.Any(b => b.restantesMobile > 0))
            .SelectMany(a => a.tipoPrestaciones ?? new List<TipoPrestacion>())
            .FirstOrDefault(tp => tp._id == id);
    }

    private Agenda? ObtenerAgendaPorIdBloque(string idBloque)
    {
        return lstAgendas?
            .SelectMany(org => org.agendas ?? new List<Agenda>())
            .FirstOrDefault(agenda =>
                agenda.bloques != null &&
                agenda.bloques.Any(bloque => bloque._id == idBloque)
            );
    }

    private IEnumerable<(AgendaOrganizacion Efector, string Domicilio)> ObtenerEfectores(string _idTipoPrestacion)
    {
        return lstAgendas?
            .SelectMany(e => e.agendas
                .Where(a => a.bloques != null && a.bloques.Any(b => b.restantesMobile > 0))
                .Where(a => (a.tipoPrestaciones ?? new List<TipoPrestacion>())
                    .Any(tp => tp!._id == _idTipoPrestacion))
                .Select(a => (
                    a.organizacion,
                    _domiciliosOrganizaciones.TryGetValue(a.organizacion._id, out var domicilio) ? domicilio : ""
                ))
            )
            .Where(x => x.organizacion != null)
            .DistinctBy(x => x.organizacion!._id)
            ?? Enumerable.Empty<(AgendaOrganizacion, string)>();
    }

    private IEnumerable<Bloque> RecuperarAgendas(string _idTipoPrestacion, string Efector)
    {
        return lstAgendas?
            .SelectMany(e => e.agendas
                    .Where(a =>
                a.bloques != null
                && a.organizacion?._id == Efector
                && (a.tipoPrestaciones ?? new List<TipoPrestacion>())
                    .Any(tp => tp._id == _idTipoPrestacion)
                && a.bloques.Any(b =>
                    b.restantesMobile > 0
                    && b.turnos.Any(c => c.estado == "disponible")
                )
            )
            .SelectMany(a => a.bloques
                .Where(b =>
                    b.restantesMobile > 0
                    && b.turnos.Any(c => c.estado == "disponible")
                )
            )
        )
        ?? Enumerable.Empty<Bloque>();
    }

    /// <summary>
    /// Obtiene el primer turno disponible para un tipo de prestación y efector
    /// </summary>
    /// <param name="tipoPrestacionId">ID del tipo de prestación</param>
    /// <param name="efectorId">ID del efector</param>
    /// <returns>Tupla con el primer turno disponible y el ID del bloque</returns>
    private (MisTurnos?, string?) ObtenerPrimerTurnoDisponible(string tipoPrestacionId, string efectorId)
    {
        foreach (var bloque in RecuperarAgendas(tipoPrestacionId, efectorId))
        {
            var primerTurnoDisponible = bloque.turnos
                .FirstOrDefault(t => t.estado == "disponible");

            return (primerTurnoDisponible, bloque._id);
        }
        return (null, null);
    }
}