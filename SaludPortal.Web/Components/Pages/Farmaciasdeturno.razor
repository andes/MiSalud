@page "/Farmaciasdeturno"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Authorization
@using SaludPortal.Web.Services
@using AndesServices.Interfaces
@using AndesServices.Entities.ViewModels
@using AndesServices.Entities
@using SaludPortal.Web.Components.Shared

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IFarmaciasTurno _farmaciasTurnoService
@inject IPaciente _pacienteService
@inject BlazorSpinner.SpinnerService _spinnerService
@inject AndesServices.Entities.ViewModels.VMFarmaciasTurno Model
@inherits AuthenticatedComponentBase

<h1>Farmacias de turno</h1>
<hr />
<br />
@* <div class="form-control"> *@
<p>
    Localidad:
    <InputSelect id="localidades" @bind-Value="Model.LocalidadId" @bind-Value:after="BuscarFarmacias" aria-label="Seleccione una localidad">
        <option value="">(Seleccione una localidad)</option>
        @if (Model.LstLocalidad != null)
        {
            @foreach (var localidad in Model.LstLocalidad)
            {
                <option value="@localidad.localidadId">@localidad.nombre</option>
            }
        }
    </InputSelect>
</p>
@* <p>Fecha desde: <InputText type="date" id="fechaDesde" @bind-value="Model.FechaDesde" aria-label="Fecha desde" /></p>
    <p>Fecha hasta: <InputText type="date" id="fechaHasta" @bind-Value="Model.FechaHasta" aria-label="Fecha hasta" /></p> *@

@* <p><button class="btn btn-verde" @onclick="BuscarFarmacias">Buscar</button></p> *@

<div>

    @if (Model.LstFarmaciasTurno != null)
    {
        @foreach (FarmaciasTurno unaFarmacia in Model.LstFarmaciasTurno)
        {
            <div class="form-control turno" style="box-shadow: 2px 2px 4px #000000;margin-bottom:5px;">
                <p><strong>Farmacia: </strong>@unaFarmacia.Nombre</p>
                <p>Dirección: @unaFarmacia.Direccion - <a href="https://maps.google.com/?q=@unaFarmacia.Latitud.ToString().Replace(",", "."),@unaFarmacia.Longitud.ToString().Replace(",", ".")" style="color:#fff;" target="_blank">Ver en mapa</a></p>
                <p>Teléfono: @unaFarmacia.Telefono</p>
                <p>Fecha: @unaFarmacia.Fecha.ToString("dd/MM/yyyy")</p>
            </div>
        }
    }
</div>
@* </div> *@
@code {
    private VMFarmaciasTurno VMFarmaciasTurno = new VMFarmaciasTurno();
    private List<AndesServices.Entities.Localidad> lstLocalidades = new List<AndesServices.Entities.Localidad>();

    protected override async Task OnAuthenticatedInitializedAsync()
    {
        _spinnerService.Show();
        lstLocalidades = await _farmaciasTurnoService.ObtenerLocalidadesAsync();
        Model.LstLocalidad = (lstLocalidades != null && lstLocalidades.Count() > 0 ? lstLocalidades : null);

        // obtener la localidad del paciente
        Paciente paciente = await _pacienteService.ObtenerPacientePorIdAsync(BackendToken, PacienteId);
        string localidadPaciente = _pacienteService.ObtenerDireccionPrioritaria(paciente)?.ubicacion?.localidad?.nombre ?? "";

        string localidadId = null;
        if (Model.LstLocalidad != null)
        {
            if (Model.LstLocalidad.Where(loc => loc.nombre.ToLower().Trim() == localidadPaciente.ToLower().Trim()) != null && localidadPaciente != "")
            {
                localidadId = Model.LstLocalidad.Where(loc => loc.nombre.ToLower().Trim() == localidadPaciente.ToLower().Trim()).FirstOrDefault().localidadId;
            }

            Model.LstFarmaciasTurno = await _farmaciasTurnoService.ObtenerFarmaciasTurnoAsync(localidadId, DateTime.Now.ToString("yyyy-MM-dd"), DateTime.Now.ToString("yyyy-MM-dd"));
        }
        _spinnerService.Hide();
    }

    protected async Task BuscarFarmacias()
    {
        if (User.Identity?.IsAuthenticated != true)
        {
            var returnUrl = Nav.ToBaseRelativePath(Nav.Uri);
            Nav.NavigateTo($"/login", true);
        }

        _spinnerService.Show();
        Model.LstFarmaciasTurno = await _farmaciasTurnoService.ObtenerFarmaciasTurnoAsync(Model.LocalidadId, DateTime.Now.ToString("yyyy-MM-dd"), DateTime.Now.ToString("yyyy-MM-dd"));
        _spinnerService.Hide();
    }
}