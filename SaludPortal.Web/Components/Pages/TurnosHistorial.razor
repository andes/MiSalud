@page "/turnosHistorial"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Authorization
@using SaludPortal.Web.Components.Modals
@using SaludPortal.Web.Components.Shared
@using SaludPortal.Web.Components.Icons
@using SaludPortal.Web.Services
@using AndesServices.Interfaces
@using System.Security.Claims
@using AndesServices.Entities
@using System.Linq

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject BlazorSpinner.SpinnerService _spinnerService
@inject IMisTurnos _misTurnosService

@inherits AuthenticatedComponentBase

<div class="turnos-historial-container">
    <PageHeader Title="Mis turnos: Historial" Subtitle="Historial de turnos médicos" />

    @if (lstMisTurnos == null || !lstMisTurnos.Any())
    {
        <EmptyState Message="No se encontraron turnos en el historial." />
    }
    else
    {
        numerar = 0;

    var turnosAgrupados = lstMisTurnos
        .Where(t => t.tipoPrestacion != null && !string.IsNullOrEmpty(t.tipoPrestacion.conceptId))
        .GroupBy(t => t.tipoPrestacion.conceptId)
        .Select(g => new
        {
            TipoPrestacionConceptId = g.Key,
                TipoPrestacionTerm = g.First().tipoPrestacion?.term,
            Turnos = g.ToList()
        })
        .ToList();

    var turnosSinTipo = lstMisTurnos
        .Where(t => t.tipoPrestacion == null || string.IsNullOrEmpty(t.tipoPrestacion.conceptId))
        .ToList();

        var sectionIndex = 0;

    @foreach (var grupo in turnosAgrupados)
    {
            var turnosPasados = grupo.Turnos.Where(t => t.horaInicio < DateTime.Now).OrderByDescending(t => t.horaInicio).ToList();
            
            @if (turnosPasados.Any())
        {
                var collapseId = $"collapse-turnos-{sectionIndex}";
                var headerId = $"header-turnos-{sectionIndex}";
                sectionIndex++;
                
                <div class="turnos-section">
                    <div class="turnos-section-header" id="@headerId">
                        <button class="turnos-collapse-button" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="true" aria-controls="@collapseId">
                            <div class="turnos-section-title">
                                <Icon Name="calendar-check" Size="24" Fill="#87b867" AriaLabel="Tipo de prestación" />
                                <span>@(grupo.TipoPrestacionTerm?.ToUpper() ?? "SIN TIPO")</span>
                            </div>
                        </button>
                    </div>
                    <div id="@collapseId" class="collapse" aria-labelledby="@headerId">
                        <div class="turnos-grid">
                            @foreach (var miTurno in turnosPasados)
                            {
                                numerar += 1;
                                <TurnoCard Turno="miTurno" Numero="numerar" OnClick="HandleTurnoClick" />
                            }
                        </div>
                    </div>
                </div>
            }
    }

    @if (turnosSinTipo.Any())
    {
            var turnosSinTipoPasados = turnosSinTipo.Where(t => t.horaInicio < DateTime.Now).OrderByDescending(t => t.horaInicio).ToList();
            
            @if (turnosSinTipoPasados.Any())
            {
                var collapseId = $"collapse-turnos-{sectionIndex}";
                var headerId = $"header-turnos-{sectionIndex}";
                
                <div class="turnos-section">
                    <div class="turnos-section-header" id="@headerId">
                        <button class="turnos-collapse-button" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                            <div class="turnos-section-title">
                                <Icon Name="calendar-x" Size="24" Fill="#87b867" AriaLabel="Sin tipo" />
                                <span>SIN TIPO DE PRESTACIÓN</span>
                            </div>
                        </button>
                    </div>
                    <div id="@collapseId" class="collapse" aria-labelledby="@headerId">
                        <div class="turnos-grid">
                            @foreach (var miTurno in turnosSinTipoPasados)
                            {
                                numerar += 1;
                                <TurnoCard Turno="miTurno" Numero="numerar" OnClick="HandleTurnoClick" />
                            }
                            </div>
                    </div>
                </div>
            }
        }
    }
</div>

@code {
    private List<MisTurnos> lstMisTurnos = new List<MisTurnos>();
    private int numerar = 0;

    [CascadingParameter] IModalService Modal { get; set; } = default!;

    private async Task HandleTurnoClick(MisTurnos turno)
    {
        await ShowModal(turno);
    }

    private async Task ShowModal(MisTurnos unTurno)
    {
        var options = new ModalOptions()
        {
            Size = ModalSize.Automatic,
            Position = ModalPosition.TopCenter,
            HideCloseButton = true,
            HideHeader = true
        };
        var parameters = new ModalParameters()
        .Add(nameof(MisTurnosDetalle.Paciente), unTurno.paciente.nombre + " " + unTurno.paciente.apellido)
        .Add(nameof(MisTurnosDetalle.FechaHoraTurno), unTurno.horaInicio.ToString("dd/MM/yyyy") + " " + DateTimeHelper.ToArgentinaTime(unTurno.horaInicio).ToString("HH:mm"))
        .Add(nameof(MisTurnosDetalle.DatosConsulta), unTurno.motivoConsulta)
        .Add(nameof(MisTurnosDetalle.Lugar), unTurno.organizacion?.nombre);

        Modal.Show<MisTurnosDetalle>(parameters, options);

    }

    protected override async Task OnAuthenticatedInitializedAsync()
    {
        numerar = 0;
        var token = BackendToken;
        if (string.IsNullOrEmpty(token))
            return;

        _spinnerService.Show();
        lstMisTurnos = await _misTurnosService.ObtenerMisTurnosAsync(Documento ?? "");
        _spinnerService.Hide();
    }
}
