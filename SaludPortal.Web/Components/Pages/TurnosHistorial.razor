@page "/turnosHistorial"


@using Microsoft.AspNetCore.Components.Authorization
@using SaludPortal.Web.Components.Modals
@using SaludPortal.Web.Components.Shared
@using SaludPortal.Web.Services
@using System.Security.Claims
@using AndesServices.Entities

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IConfiguration Configuration
@inject IHttpClientFactory httpClientFactory
@inject BlazorSpinner.SpinnerService _spinnerService

@inherits AuthenticatedComponentBase

<style>
    .asistencia {
        border: solid 2px #06bc06;
        color: #06bc06;
        border-radius: 20px;
        padding: 5px 10px;
        max-width: 200px;
        font-size: 13px;
        text-align: center;
    }

    .inasistencia {
        border: solid 2px #ccc;
        color: #ccc;
        border-radius: 20px;
        padding: 5px 10px;
        max-width: 200px;
        font-size: 13px;
        text-align: center;
    }

    .turno {
        cursor: pointer;
    }

        .turno:hover {
            background-color: #035676;
        }
</style>

<h1>Mis turnos: Historial</h1>
<hr />
<br />
@if (lstMisTurnos != null)
{
    @@numerar = 0;

    var turnosAgrupados = lstMisTurnos
        .Where(t => t.tipoPrestacion != null && !string.IsNullOrEmpty(t.tipoPrestacion.conceptId))
        .GroupBy(t => t.tipoPrestacion.conceptId)
        .Select(g => new
        {
            TipoPrestacionConceptId = g.Key,
            Turnos = g.ToList()
        })
        .ToList();

    // Turnos sin tipoPrestacion
    var turnosSinTipo = lstMisTurnos
        .Where(t => t.tipoPrestacion == null || string.IsNullOrEmpty(t.tipoPrestacion.conceptId))
        .ToList();

    @foreach (var grupo in turnosAgrupados)
    {
        @* var misTurnos in lstMisTurnos.Where(t => t.tipoPrestacion == ).OrderByDescending(t => t.horaInicio)) *@
        @foreach (var miTurno in grupo.Turnos.OrderByDescending(t => t.horaInicio))
        {
            if (tipoPrestacion != grupo.TipoPrestacionConceptId)
            {
                <h2>@miTurno.tipoPrestacion?.term?.ToUpper()</h2>
                tipoPrestacion = grupo.TipoPrestacionConceptId;
            }

            @if (miTurno != null)
            {
                <a @onclick="() => ShowModal(miTurno)">
                    @* <a> *@
                    @if (miTurno.horaInicio < DateTime.Now)
                    {
                        numerar += 1;
                        <div class="form-control turno" style="box-shadow: 2px 2px 4px #000000;margin-bottom:5px;" tabindex="0">
                            @if (miTurno.tipoPrestacion != null)
                            {
                                @if (miTurno.tipoPrestacion.term != null)
                                {
                                    <p><strong>@numerar </strong></p>
                                }

                                <p><strong>Fecha turno: </strong>@miTurno.horaInicio.ToString("dd/MM/yyyy") @miTurno.horaInicio.AddHours(-3).ToString("HH:mm")</p>

                                @if (miTurno.asistencia != null)
                                {
                                    <div>
                                        @if (@miTurno.asistencia == "noAsistio")
                                        {
                                            <p class="inasistencia">SIN DATOS DE ASISTENCIA</p>
                                        }
                                        else
                                        {
                                            if (@miTurno.horaAsistencia != null)
                                            {
                                                <p class="asistencia">ASISTENCIA A LAS @miTurno.horaAsistencia!?.ToString("HH:mm") HS</p>
                                            }
                                            else
                                            {
                                                <p class="asistencia">ASISTIÓ</p>
                                            }
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="inasistencia">SIN DATOS DE ASISTENCIA</p>
                                }

                                @if (miTurno.profesionales != null)
                                {
                                    @if (miTurno.profesionales.Count() > 0)
                                    {
                                        <div style="font-size:13px;">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person-vcard" viewBox="0 0 16 16">
                                                <path d="M5 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4m4-2.5a.5.5 0 0 1 .5-.5h4a.5.5 0 0 1 0 1h-4a.5.5 0 0 1-.5-.5M9 8a.5.5 0 0 1 .5-.5h4a.5.5 0 0 1 0 1h-4A.5.5 0 0 1 9 8m1 2.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 0 1h-3a.5.5 0 0 1-.5-.5" />
                                                <path d="M2 2a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2zM1 4a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H8.96q.04-.245.04-.5C9 10.567 7.21 9 5 9c-2.086 0-3.8 1.398-3.984 3.181A1 1 0 0 1 1 12z" />
                                            </svg>
                                            Profesional:
                                        </div>
                                        <ul style="font-size:12px;">
                                            @foreach (Profesional unProfesional in miTurno.profesionales)
                                            {
                                                <li>
                                                    @unProfesional.apellido @unProfesional.nombre
                                                </li>
                                            }
                                        </ul>
                                    }
                                }
                                @if (miTurno.organizacion != null)
                                {
                                    <p style="font-size:12px;">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-hospital" viewBox="0 0 16 16">
                                            <path d="M8.5 5.034v1.1l.953-.55.5.867L9 7l.953.55-.5.866-.953-.55v1.1h-1v-1.1l-.953.55-.5-.866L7 7l-.953-.55.5-.866.953.55v-1.1zM13.25 9a.25.25 0 0 0-.25.25v.5c0 .138.112.25.25.25h.5a.25.25 0 0 0 .25-.25v-.5a.25.25 0 0 0-.25-.25zM13 11.25a.25.25 0 0 1 .25-.25h.5a.25.25 0 0 1 .25.25v.5a.25.25 0 0 1-.25.25h-.5a.25.25 0 0 1-.25-.25zm.25 1.75a.25.25 0 0 0-.25.25v.5c0 .138.112.25.25.25h.5a.25.25 0 0 0 .25-.25v-.5a.25.25 0 0 0-.25-.25zm-11-4a.25.25 0 0 0-.25.25v.5c0 .138.112.25.25.25h.5A.25.25 0 0 0 3 9.75v-.5A.25.25 0 0 0 2.75 9zm0 2a.25.25 0 0 0-.25.25v.5c0 .138.112.25.25.25h.5a.25.25 0 0 0 .25-.25v-.5a.25.25 0 0 0-.25-.25zM2 13.25a.25.25 0 0 1 .25-.25h.5a.25.25 0 0 1 .25.25v.5a.25.25 0 0 1-.25.25h-.5a.25.25 0 0 1-.25-.25z" />
                                            <path d="M5 1a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v1a1 1 0 0 1 1 1v4h3a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1h3V3a1 1 0 0 1 1-1zm2 14h2v-3H7zm3 0h1V3H5v12h1v-3a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1zm0-14H6v1h4zm2 7v7h3V8zm-8 7V8H1v7z" />
                                        </svg>  @miTurno.organizacion.nombre
                                    </p>
                                }
                            }
                        </div>
                    }
                </a>
            }
        }
        <hr />
    }

    @* Mostrar turnos sin tipo de prestación *@
    @if (turnosSinTipo.Any())
    {
        <h2>SIN TIPO DE PRESTACIÓN</h2>
        @foreach (var miTurno in turnosSinTipo.OrderByDescending(t => t.horaInicio))
        {
            @if (miTurno != null && miTurno.horaInicio < DateTime.Now)
            {
                numerar += 1;
                <a @onclick="() => ShowModal(miTurno)">
                    <div class="form-control turno" style="box-shadow: 2px 2px 4px #000000;margin-bottom:5px;" tabindex="0">
                        <p><strong>@numerar </strong></p>
                        <p><strong>Fecha turno: </strong>@miTurno.horaInicio.ToString("dd/MM/yyyy") @miTurno.horaInicio.AddHours(-3).ToString("HH:mm")</p>

                        @if (miTurno.asistencia != null)
                        {
                            <div>
                                @if (@miTurno.asistencia == "noAsistio")
                                {
                                    <p class="inasistencia">SIN DATOS DE ASISTENCIA</p>
                                }
                                else
                                {
                                    if (@miTurno.horaAsistencia != null)
                                    {
                                        <p class="asistencia">ASISTENCIA A LAS @miTurno.horaAsistencia!?.ToString("HH:mm") HS</p>
                                    }
                                    else
                                    {
                                        <p class="asistencia">ASISTIÓ</p>
                                    }
                                }
                            </div>
                        }
                        else
                        {
                            <p class="inasistencia">SIN DATOS DE ASISTENCIA</p>
                        }

                        @if (miTurno.profesionales != null && miTurno.profesionales.Count() > 0)
                        {
                            <div style="font-size:13px;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person-vcard" viewBox="0 0 16 16">
                                    <path d="M5 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4m4-2.5a.5.5 0 0 1 .5-.5h4a.5.5 0 0 1 0 1h-4a.5.5 0 0 1-.5-.5M9 8a.5.5 0 0 1 .5-.5h4a.5.5 0 0 1 0 1h-4A.5.5 0 0 1 9 8m1 2.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 0 1h-3a.5.5 0 0 1-.5-.5" />
                                    <path d="M2 2a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2zM1 4a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H8.96q.04-.245.04-.5C9 10.567 7.21 9 5 9c-2.086 0-3.8 1.398-3.984 3.181A1 1 0 0 1 1 12z" />
                                </svg>
                                Profesional:
                            </div>
                            <ul style="font-size:12px;">
                                @foreach (Profesional unProfesional in miTurno.profesionales)
                                {
                                    <li>
                                        @unProfesional.apellido @unProfesional.nombre
                                    </li>
                                }
                            </ul>
                        }
                        @if (miTurno.organizacion != null)
                        {
                            <p style="font-size:12px;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-hospital" viewBox="0 0 16 16">
                                    <path d="M8.5 5.034v1.1l.953-.55.5.867L9 7l.953.55-.5.866-.953-.55v1.1h-1v-1.1l-.953.55-.5-.866L7 7l-.953-.55.5-.866.953.55v-1.1zM13.25 9a.25.25 0 0 0-.25.25v.5c0 .138.112.25.25.25h.5a.25.25 0 0 0 .25-.25v-.5a.25.25 0 0 0-.25-.25zM13 11.25a.25.25 0 0 1 .25-.25h.5a.25.25 0 0 1 .25.25v.5a.25.25 0 0 1-.25.25h-.5a.25.25 0 0 1-.25-.25zm.25 1.75a.25.25 0 0 0-.25.25v.5c0 .138.112.25.25.25h.5a.25.25 0 0 0 .25-.25v-.5a.25.25 0 0 0-.25-.25zm-11-4a.25.25 0 0 0-.25.25v.5c0 .138.112.25.25.25h.5A.25.25 0 0 0 3 9.75v-.5A.25.25 0 0 0 2.75 9zm0 2a.25.25 0 0 0-.25.25v.5c0 .138.112.25.25.25h.5a.25.25 0 0 0 .25-.25v-.5a.25.25 0 0 0-.25-.25zM2 13.25a.25.25 0 0 1 .25-.25h.5a.25.25 0 0 1 .25.25v.5a.25.25 0 0 1-.25.25h-.5a.25.25 0 0 1-.25-.25z" />
                                    <path d="M5 1a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v1a1 1 0 0 1 1 1v4h3a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1h3V3a1 1 0 0 1 1-1zm2 14h2v-3H7zm3 0h1V3H5v12h1v-3a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1zm0-14H6v1h4zm2 7v7h3V8zm-8 7V8H1v7z" />
                                </svg>  @miTurno.organizacion.nombre
                            </p>
                        }
                    </div>
                </a>
            }
        }
        <hr />
    }
}

@code {
    private string tipoPrestacion = "";
    private List<MisTurnos> lstMisTurnos = new List<MisTurnos>();
    private MisTurnosService? _misTurnosService;
    private int numerar = 0;
    // private string fechaHoraAtencion = "";
    // private string Paciente = "";
    // private string DatosConsulta = "";
    // private string LugarAtencion = "";

    [CascadingParameter] IModalService Modal { get; set; } = default!;

    private async Task ShowModal(MisTurnos unTurno)
    {
        var options = new ModalOptions()
        {
            Size = ModalSize.Automatic,
            Position = ModalPosition.TopCenter,
            HideCloseButton = true,
            HideHeader = true
        };
        var parameters = new ModalParameters()
        .Add(nameof(MisTurnosDetalle.Paciente), unTurno.paciente.nombre + " " + unTurno.paciente.apellido)
        .Add(nameof(MisTurnosDetalle.FechaHoraTurno), unTurno.horaInicio.ToString("dd/MM/yyyy") + " " + unTurno.horaInicio.AddHours(-3).ToString("HH:mm"))
        .Add(nameof(MisTurnosDetalle.DatosConsulta), unTurno.motivoConsulta)
        .Add(nameof(MisTurnosDetalle.Lugar), unTurno.organizacion?.nombre);

        Modal.Show<MisTurnosDetalle>(parameters, options);

    }

    protected override async Task OnAuthenticatedInitializedAsync()
    {
        numerar = 0;
        var token = BackendToken;
        if (string.IsNullOrEmpty(token))
            return;

        _misTurnosService = new MisTurnosService(Configuration, httpClientFactory);

        if (_misTurnosService != null)
        {
            _spinnerService.Show();
            lstMisTurnos = await _misTurnosService.ObtenerMisTurnosAsync(token);
            _spinnerService.Hide();
        }
    }
}
