@page "/historiasalud"
@rendermode InteractiveServer

@using AndesServices.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@using SaludPortal.Web.Components.Shared
@using SaludPortal.Web.Services
@using AndesServices.Entities.ViewModels
@using AndesServices.Entities

@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IConfiguration Configuration
@inject BlazorSpinner.SpinnerService _spinnerService
@inject AndesServices.Entities.ViewModels.VMHistoriaSalud Model
@inject IJSRuntime JSRuntime
@inherits AuthenticatedComponentBase
@inject IHistoriaSalud _miHistoriaSaludService 
<h1>Historia de Salud</h1>
<hr />
<h2>Categorias</h2>

@if (Model.lstCategoriasHistoriaSalud != null)
{
    @foreach (var categoria in Model.lstCategoriasHistoriaSalud)
    {
        <button class="btn btn-azul btn-icon-right" style="width:90%" @onclick="@(() => IrACategoria(categoria.ExpresionSnomed, categoria.Titulo))">
            <span>@categoria.Titulo</span>
            <i class="fa fa-chevron-right" aria-hidden="true"></i>
        </button>
        <br />
    }
}
@code {
    private VMHistoriaSalud vmHistoriaSalud = new VMHistoriaSalud();
    private List<AndesServices.Entities.CategoriaHistoriaSalud> lstCategorias = new List<AndesServices.Entities.CategoriaHistoriaSalud>();

    protected override async Task OnAuthenticatedInitializedAsync()
    {
        var token = BackendToken;
        if (string.IsNullOrEmpty(token))
            return;

        _spinnerService.Show();
        Model.lstCategoriasHistoriaSalud = await _miHistoriaSaludService.ObtenerCategoriasHistoriaSaludAsync(BackendToken);
        _spinnerService.Hide();
    }

    protected async Task BuscarHistoriaSalud(string idTipoPrestacion)
    {
        var token = BackendToken;
        if (string.IsNullOrEmpty(token))
            return;

        var pacienteId = PacienteId;
        if (string.IsNullOrEmpty(pacienteId))
            return;

        _spinnerService.Show();
        Model.lstPrestacionesHistoriaSalud = await _miHistoriaSaludService.ObtenerPrestacionesAsync(token, idTipoPrestacion, pacienteId);
        _spinnerService.Hide();
    }

    private async void IrACategoria(string? expresionSnomed, string? titulo)
    {
        if (string.IsNullOrWhiteSpace(expresionSnomed))
            return;

        var exprEncoded = Uri.EscapeDataString(expresionSnomed);
        var tituloEncoded = Uri.EscapeDataString(titulo ?? string.Empty);

        var cfg = new ConexionServicios();
        Configuration.GetSection("urlServicios").Bind(cfg);

        if (expresionSnomed == "103695000" && !cfg.usarProd)
        {
            await JSRuntime.InvokeVoidAsync("open", Nav.BaseUri + "docs/Certificado médico OLAVE.pdf", "_blank");
            // Nav.NavigateTo($"/docs/Certificado médico OLAVE.pdf",true);
            // return;
        }
        else
        {
            if (expresionSnomed == "16076005") //Recetas
                Nav.NavigateTo($"MisRecetas");
            else
                Nav.NavigateTo($"/historiasalud/categoria/{exprEncoded}?titulo={tituloEncoded}");
        }
    }
}
