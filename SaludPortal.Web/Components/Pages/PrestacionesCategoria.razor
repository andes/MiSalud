@page "/historiasalud/categoria/{expresionSnomed}/"
@rendermode InteractiveServer

@using AndesServices.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using SaludPortal.Web.Components.Icons
@using SaludPortal.Web.Components.Shared
@using SaludPortal.Web.Services
@using AndesServices.Entities.ViewModels
@using AndesServices.Entities
@using System.Text.Json

@inject IHttpClientFactory HttpClientFactory
@inject BlazorSpinner.SpinnerService _spinnerService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inherits AuthenticatedComponentBase
@inject IHistoriaSalud _miHistoriaSaludService

<style>
    .prestaciones p {
        margin: 0px;
    }

    .prestaciones {
        cursor: pointer;
        box-shadow: 2px 2px 4px #000000;
        margin-bottom: 5px;
    }
</style>


<h1>@TituloMostrar</h1>
<hr />

@if (cargando)
{
    <p>Cargando...</p>
}
else if (error != null)
{
    <div class="alert alert-danger">@error</div>
}
else if (prestaciones == null || prestaciones.Count == 0)
{
    <p>No se encontraron prestaciones.</p>
}
else
{
    @foreach (var p in prestaciones.OrderByDescending(p => p.ejecucion?.fecha))
    {
        string archivo = "";
        if (p.paciente.adjuntos != null && p.paciente.adjuntos[0] != null && p.paciente.adjuntos[0] != "")
        {
            archivo = p.paciente.adjuntos[0];
            archivo = p.paciente.adjuntos[0]?.Substring(p.paciente.adjuntos[0].LastIndexOf('/') + 1, p.paciente.adjuntos[0].LastIndexOf('.') - p.paciente.adjuntos[0].LastIndexOf('/') - 1);
        }

        <div class="form-control d-flex justify-content-between prestaciones" title="Descargar">
            <div @onclick="@(() => DownloadPrestacion(archivo))" tabindex="0">
                <div>
                    <strong>@(p.solicitud?.tipoPrestacion?.term ?? "Prestación")</strong><br />
                </div>
                <div>
                    <strong><Icon Name="hospital" Size="16" Fill="#fff" class="text-secondary me-1" AriaLabel="Institución" /></strong>@(p.solicitud?.organizacion?.nombre ?? "Organización")<br />
                </div>
                <div>
                    <strong>Fecha: </strong>
                    @(p.ejecucion?.fecha != null 
                        ? DateTimeHelper.ToArgentinaTime(p.ejecucion.fecha)?.ToString("dd/MM/yyyy") + " " + DateTimeHelper.ToArgentinaTime(p.ejecucion.fecha)?.ToString("HH:mm") 
                        : "")
                </div>
                <div>
                    <strong>Profesional: </strong>
                    @(p.solicitud?.profesional?.nombre ?? "Sin datos") @(p.solicitud?.profesional?.apellido ?? "Sin datos")
                </div>
                <div>
                    <strong>Documento: </strong> @(p.solicitud?.profesional?.documento ?? "Sin datos")<br />
                </div>
                <div>
                    @if (p.solicitud?.registros != null && p.solicitud?.registros.Count() > 0)
                    {
                        foreach (var registro in p.solicitud?.registros ?? Enumerable.Empty<Registro>())
                        @* @foreach (var registro in p.solicitud.registros!) *@
                        {
                            if (registro.valor is { } ve && ve.ValueKind == JsonValueKind.Object)
                            {
                                if (ve.TryGetProperty("solicitudPrestacion", out _))
                                {
                                    var sol = ve.Deserialize<WrapperSolicitudPrestacion>();

                                    <div>
                                        <div>
                                            <strong> Solicitud: </strong> @sol.solicitudPrestacion?.prestacionSolicitada?.term
                                        </div>
                                        <div>
                                            <strong>Motivo: </strong> @sol.solicitudPrestacion?.motivo
                                        </div>
                                        <div>
                                            <strong>Indicaciones: </strong> @sol.solicitudPrestacion?.indicaciones
                                        </div>
                                    </div>
                                }
                                @* else if (ve.TryGetProperty("solicitudPrestacion", out _))
                            {
                                var sol = ve.Deserialize<WrapperSolicitudPrestacion>();
                            } *@
                            }

                        }
                    }
                </div>
            </div>
            @if (esCda)
            {
                <div class="align-content-center">
                    <Icon Name="cloud-download" Size="32" Fill="#fff" class="text-secondary me-1" AriaLabel="Descargar" />
                </div>
            }
        </div>
    }
}
<br />
<a href="historiaSalud" title="Historia de salud" class="btn btn-celeste"> Volver</a>

<script type="text/javascript">

    function openPdf(archivo, categoria) {
    const pdfData = "data:application/pdf;base64," + archivo;

    const a = document.createElement("a");
    document.body.appendChild(a);
    a.href = pdfData;
    a.download = "prestacion_" + categoria + ".pdf";
    a.target = "_self";
    a.click();
    }
</script>

@code {
    [Parameter] public string? expresionSnomed { get; set; }

    private string? titulo;
    private List<PrestacionHistoriaSalud>? prestaciones;
    private bool cargando;
    private string? error;
    private string TituloMostrar => string.IsNullOrWhiteSpace(titulo) ? expresionSnomed ?? "" : titulo!;
    private string fecha;
    private Byte[] archivoDescargar = null;

    private bool esCda => expresionSnomed == "90226004" || expresionSnomed == "86273004";

    protected override async Task OnAuthenticatedInitializedAsync()
    {
        var token = BackendToken;
        if (string.IsNullOrEmpty(token))
            return;

        var pacienteId = PacienteId;
        if (string.IsNullOrEmpty(pacienteId))
            return;
    }

    protected override async Task OnParametersSetAsync()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (!string.IsNullOrEmpty(uri.Query))
        {
            var query = QueryHelpers.ParseQuery(uri.Query);
            if (query.TryGetValue("titulo", out var v))
            {
                titulo = Uri.UnescapeDataString(v.ToString());
            }
        }

        if (string.IsNullOrWhiteSpace(expresionSnomed))
        {
            error = "Expresión inválida.";
            return;
        }

        var token = BackendToken;
        var pacienteId = PacienteId;
        if (string.IsNullOrEmpty(token) || string.IsNullOrEmpty(pacienteId))
        {
            error = "No hay contexto de autenticación.";
            return;
        }

        cargando = true;
        error = null;
        _spinnerService.Show();
        try
        {
            prestaciones = await _miHistoriaSaludService.ObtenerPrestacionesAsync(token, expresionSnomed, pacienteId);
        }
        catch (Exception ex)
        {
            error = "Error obteniendo prestaciones: " + ex.Message;
        }
        finally
        {
            _spinnerService.Hide();
            cargando = false;
        }
    }

    async Task DownloadPrestacion(string idPrestacion)
    {
        _spinnerService.Show();

        if (esCda)
        {
            var token = BackendToken;
            archivoDescargar = await _miHistoriaSaludService.DescargarCDAFilePorIdAsync(token, idPrestacion);
            if (archivoDescargar == null || archivoDescargar.Length == 0)
            {
                _spinnerService.Hide();
                await JSRuntime.InvokeVoidAsync("alert", "No se encontró el archivo de la prestación.");
                return;
            }

            string base64Pdf = Convert.ToBase64String(archivoDescargar);
            await JSRuntime.InvokeVoidAsync("openPdf", base64Pdf, TituloMostrar);
        }
        else
        {
            // archivoDescargar = await _miHistoriaSaludService..DescargarLaboratorio(BackendToken, idProtocolo, Documento);
            // if (archivoDescargar == null || archivoDescargar.Length == 0)
            // {
            //     _spinnerService.Hide();
            //     await JSRuntime.InvokeVoidAsync("alert", "No se encontró el archivo del laboratorio.");
            //     return;
            // }

            // string base64Pdf = Convert.ToBase64String(archivoDescargar);
            // await JSRuntime.InvokeVoidAsync("openPdf", base64Pdf);
        }
        _spinnerService.Hide();
    }

    private void Volver()
    {
        NavigationManager.NavigateTo("/historiasalud");
    }
}