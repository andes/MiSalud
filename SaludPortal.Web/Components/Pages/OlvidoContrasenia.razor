@page "/olvidocontrasenia"
@page "/recuperocontrasenia"
@using System.Net.Http.Headers
@using System.ComponentModel.DataAnnotations
@using SaludPortal.Web.Models

@layout LoginLayout
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@inject HttpClient Http

<style>
    .label-info{
        border-radius: 5px;
        padding: 10px;
        background-color: #00374c;
        line-height: 1;
        color: #fff;
    }

    .form-control{
        background-color:#fff;
        color: #333;
    }

</style>
<title>Solicitud recupero de datos de acceso</title>
<h1>Solicitud recupero de datos de acceso</h1>

@if (_enviado)
{
    <div class="alert alert-success">Solicitud enviada. Gracias.</div>
}
else
{
    <EditForm Model="_model" OnValidSubmit="OnSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-2">
            <label for="_model.Nombre">Nombre</label>
            <InputText id="_model.Nombre" class="form-control" @bind-Value="_model.Nombre" />
            <ValidationMessage For="@(() => _model.Nombre)" />
        </div>
        <div class="mb-2">
            <label for="_model.Apellido">Apellido</label>
            <InputText id="_model.Apellido" class="form-control" @bind-Value="_model.Apellido" />
            <ValidationMessage For="@(() => _model.Apellido)" />
        </div>
        <div class="mb-2">
            <label for="_model.Documento">Documento</label>
            <InputText id="_model.Documento" class="form-control" @bind-Value="_model.Documento" />
            <ValidationMessage For="@(() => _model.Documento)" />
        </div>
        <div class="mb-2">
            <label for="_model.Email">Email</label>
            <InputText id="_model.Email" class="form-control" @bind-Value="_model.Email" />
            <ValidationMessage For="@(() => _model.Email)" />
        </div>
        <div class="mb-2">
            <label for="_model.Telefono">Teléfono celular</label>
            <InputText id="_model.Telefono" class="form-control" @bind-Value="_model.Telefono" />
            <ValidationMessage For="@(() => _model.Telefono)" />
        </div>
        <div class="mb-3">
            <label for="adjunto">Foto frente DNI (máx 5 MB)</label>
            <InputFile id="adjunto" OnChange="OnFileSelected" accept="image/*" />
            @if (!string.IsNullOrEmpty(_fileError))
            {
                <div class="text-danger small">@_fileError</div>
            }
        </div>
        <div class="mb-2">
            <label title="información importante" class="label-info">La respuesta puede demorar 48 hs hábiles. Será contactado por uno de los medios de comunicación solicitados.</label>
        </div>
        <button class="btn btn-primary" disabled="@_enviando">@(_enviando ? "Enviando..." : "Enviar")</button>
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger mt-2">@_error</div>
        }
    </EditForm>
}

@code {
    private const int MaxFileSize = 5 * 1024 * 1024;
    private OlvidoContraseniaRequest _model = new();
    private IBrowserFile? _file;
    private string? _fileError;
    private bool _enviando;
    private bool _enviado;
    private string? _error;

    private async Task OnSubmit()
    {
        _error = null;
        _fileError = null;
        _enviando = true;
        try
        {
            using var content = new MultipartFormDataContent();
            content.Add(new StringContent(_model.Nombre), "Nombre");
            content.Add(new StringContent(_model.Apellido), "Apellido");
            content.Add(new StringContent(_model.Documento), "Documento");
            content.Add(new StringContent(_model.Email), "Email");
            content.Add(new StringContent(_model.Telefono), "Telefono");

            if (_file != null)
            {
                if (_file.Size > MaxFileSize)
                {
                    _fileError = "Archivo supera 5MB.";
                    return;
                }
                var stream = _file.OpenReadStream(MaxFileSize);
                var fileContent = new StreamContent(stream);
                fileContent.Headers.ContentType = new MediaTypeHeaderValue(_file.ContentType);
                content.Add(fileContent, "FotoFrente", _file.Name);
            }

            var resp = await Http.PostAsync("/api/OlvidoContrasenia/solicitud", content);
            if (resp.IsSuccessStatusCode)
                _enviado = true;
            else
                _error = $"Error enviando la solicitud (HTTP {(int)resp.StatusCode}).";
        }
        catch (Exception ex)
        {
            _error = "Excepción: " + ex.Message;
        }
        finally
        {
            _enviando = false;
        }
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        _fileError = null;
        _file = e.File;
        if (_file.Size > MaxFileSize)
        {
            _fileError = "Archivo supera 5MB.";
            _file = null;
        }
    }

