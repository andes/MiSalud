@page "/misturnos"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Authorization
@using SaludPortal.Web.Components.Modals
@using SaludPortal.Web.Components.Shared
@using SaludPortal.Web.Components.Icons
@using SaludPortal.Web.Services
@using AndesServices.Interfaces
@using System.Security.Claims
@using AndesServices.Entities
@using System.Linq

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject BlazorSpinner.SpinnerService _spinnerService
@inject IMisTurnos _misTurnosService

@inherits AuthenticatedComponentBase

<PageTitle>Mis turnos - Mi Salud</PageTitle>

<div class="misturnos-container">
    <PageHeader Title="Mis turnos" Subtitle="Turnos programados y próximos" />
    

    @if (lstMisTurnos != null)
    {
        var turnosFuturosList = lstMisTurnos
            .Where(t => t != null && t.horaInicio >= DateTime.Now)
            .OrderBy(t => t.horaInicio)
            .ToList();

        @if (turnosFuturosList.Any())
        {
            <div class="turnos-futuros-section">
                <div class="section-title-wrapper">
                    <h2 class="section-title">
                        <Icon Name="calendar-check" Size="24" Fill="#87b867" class="me-2" AriaLabel="Turnos" />
                        Turnos Programados
                    </h2>
                </div>
                <div class="turnos-futuros-grid">
                    @foreach (var turno in turnosFuturosList)
                    {
                        <TurnoFuturoCard 
                            Turno="turno" 
                            EsTeleconsulta="EsTeleconsulta(turno.tipoPrestacion?.conceptId)" 
                            OnCancel="HandleCancelarTurno" />
                    }
                </div>
            </div>
        }
        else
        {
            <div class="calendar-icon-wrapper">
                <Icon Name="calendar2-heart" Fill="#c33995" Size="32" />
            </div>
            <EmptyState Message="No tienes ningún turno programado" />
        }
    }

    <div class="misturnos-actions">
        <a href="/turnosNuevo" class="btn btn-success">
            <Icon Name="calendar-plus" Size="20" Fill="#fff" class="me-2" AriaLabel="Solicitar" />
            Solicitar turno
        </a>
        <a href="/turnosHistorial" class="btn btn-primary">
            <Icon Name="clock-history" Size="20" Fill="#fff" class="me-2" AriaLabel="Historial" />
            Historial de turnos
        </a>
        <a href="/turnosTelesalud" class="btn btn-secondary">
            <Icon Name="camera-video" Size="20" Fill="#fff" class="me-2" AriaLabel="Telesalud" />
            Telesalud
        </a>
    </div>
</div>

@code {
    private List<MisTurnos> lstMisTurnos = new List<MisTurnos>();
    private HashSet<string> conceptosTeleconsulta = new HashSet<string>();

    [CascadingParameter] IModalService Modal { get; set; } = default!;

    protected override async Task OnAuthenticatedInitializedAsync()
    {
        var token = BackendToken;
        if (string.IsNullOrEmpty(token))
            return;

        _spinnerService.Show();
        try
        {
            // Obtengo los conceptos de teleconsulta
            var conceptosTurneables = await _misTurnosService.ObtenerConceptosTurneablesAsync(true);
            if (conceptosTurneables != null && conceptosTurneables.Count > 0)
            {
                conceptosTeleconsulta = new HashSet<string>(conceptosTurneables.Select(c => c.conceptId));
            }

            // Obtengo los turnos
            lstMisTurnos = await _misTurnosService.ObtenerMisTurnosAsync(Documento ?? "");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _spinnerService.Hide();
        }
    }

    private bool EsTeleconsulta(string? conceptId)
    {
        if (string.IsNullOrEmpty(conceptId))
            return false;
        return conceptosTeleconsulta.Contains(conceptId);
    }

    private async Task HandleCancelarTurno(MisTurnos turno)
    {
        var esTeleconsulta = EsTeleconsulta(turno.tipoPrestacion?.conceptId);
        await ShowModalCancelarConfirmar(
            turno.horaInicio,
            DateTimeHelper.ToArgentinaTime(turno.horaInicio),
            turno.tipoPrestacion?.term ?? string.Empty,
            turno.organizacion?.nombre ?? string.Empty,
            turno.agenda_id,
            turno._id,
            turno.bloque_id,
            esTeleconsulta
        );
    }

    private async Task ShowModalCancelarConfirmar(DateTime Fecha, DateTime Hora, string TipoPrestacion, string EfectorNombre, string IdAgenda, string IdTurno, string IdBloque, bool esTeleconsulta)
    {
        var options = new ModalOptions()
        {
            Size = ModalSize.Automatic,
            Position = ModalPosition.TopCenter,
            HideCloseButton = true,
            HideHeader = true
        };

        var parameters = new ModalParameters()
        .Add(nameof(MisTurnosCancelarConfirmar.FechaHoraTurno), Fecha.ToString("dd/MM/yyyy") + " " + Hora.ToString("HH:mm"))
        .Add(nameof(MisTurnosCancelarConfirmar.EfectorNombre), EfectorNombre)
        .Add(nameof(TurnoNuevoConfirmar.TipoPrestacion), TipoPrestacion)
        .Add(nameof(MisTurnosCancelarConfirmar.IdTurno), IdTurno)
        .Add(nameof(MisTurnosCancelarConfirmar.IdBloque), IdBloque)
        .Add(nameof(MisTurnosCancelarConfirmar.IdAgenda), IdAgenda)
        .Add(nameof(MisTurnosCancelarConfirmar.EsTeleconsulta), esTeleconsulta);

        Modal.Show<MisTurnosCancelarConfirmar>(parameters, options);
    }
}