    function openPdfLab(archivo) {
    const pdfData = "data:application/pdf;base64," + archivo;

    const a = document.createElement("a");
    document.body.appendChild(a);
    a.href = pdfData;
    a.download = "laboratorio.pdf";
    a.target = "_self";
    a.click();
    }

    function BlazorDownloadFile(filename, contentType, content) {

    // window.open(content);
    const pdfData = "data:application/pdf;base64," + content;
    var archivo = document.getElementById("pdffile");
    archivo.innerHTML = content;
    }
</script>

@code {
    private MisLaboratoriosService? _misLaboratoriosService;
    private Byte[] archivoDescargar = null;
    private string idProtocolo = "";

    protected async Task BuscarLaboratorios()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            if (AuthenticationStateProvider is CustomAuthenticationStateProvider customAuthProvider)
            {
                await customAuthProvider.MarkUserAsLoggedOut();
                Nav.NavigateTo("/");
            }
        }
        _misLaboratoriosService = new MisLaboratoriosService(Configuration);

        if (_misLaboratoriosService != null && GlobalServices.Usuario?.token != null)
        {
            _spinnerService.Show();
            Model.LstMisLaboratorios = await _misLaboratoriosService.ObtenerMisLaboratoriosAsync(GlobalServices.Usuario.token, GlobalServices.Usuario.pacientes[0].id, Model.FechaDesde, Model.FechaHasta);
            _spinnerService.Hide();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            if (AuthenticationStateProvider is CustomAuthenticationStateProvider customAuthProvider)
            {
                await customAuthProvider.MarkUserAsLoggedOut();
                Nav.NavigateTo("/");
            }
        }

        // Model.FechaDesde = DateTime.Now.AddDays(-30).ToString("yyyy-MM-dd");
        // Model.FechaHasta = DateTime.Now.ToString("yyyy-MM-dd");
        _misLaboratoriosService = new MisLaboratoriosService(Configuration);

        if (_misLaboratoriosService != null && GlobalServices.Usuario?.token != null)
        {
            _spinnerService.Show();
            Model.LstMisLaboratorios = await _misLaboratoriosService.ObtenerMisLaboratoriosAsync(GlobalServices.Usuario.token, GlobalServices.Usuario.pacientes[0].id, "20200101", DateTime.Now.ToString("yyyyMMdd"));
            _spinnerService.Hide();
        }
    }

    async Task DownloadLaboratorio(string idProtocolo)
    {
        _spinnerService.Show();
        archivoDescargar = await _misLaboratoriosService.descargarLaboratorio(GlobalServices.Usuario.token, idProtocolo, GlobalServices.Usuario.documento);
        if (archivoDescargar == null || archivoDescargar.Length == 0)
        {
            _spinnerService.Hide();
            await JSRuntime.InvokeVoidAsync("alert", "No se encontró el archivo del laboratorio.");
            return;
        }

        string base64Pdf = Convert.ToBase64String(archivoDescargar);
        await JSRuntime.InvokeVoidAsync("openPdfLab", base64Pdf);
        _spinnerService.Hide();
    }
}