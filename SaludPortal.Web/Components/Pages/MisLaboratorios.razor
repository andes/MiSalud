@inherits AuthenticatedComponentBase

<PageTitle>Mis laboratorios - Mi Salud</PageTitle>

<div class="laboratorios-container">
    <PageHeaderWithBack Title="Mis Laboratorios"
                        Subtitle="Historial de informes de laboratorio"
                        BackHref="/"
                        BackAriaLabel="Volver al inicio" />

    @if (Model.LstMisLaboratorios != null && _visibleLabs != null && _visibleLabs.Any())
    {
        <div class="laboratorios-section">
            <SectionTitle Title="Informes de Laboratorio" Icon="bi bi-flask-vial" />
            <div class="laboratorios-grid">
                @foreach (var misLaboratorios in _visibleLabs)
                {
                    @if (misLaboratorios != null && !string.IsNullOrEmpty(misLaboratorios.Laboratorio))
                    {
                        <LaboratorioCard Laboratorio="misLaboratorios" OnDownload="@((AndesServices.Entities.MisLaboratorios lab) => DownloadLaboratorio(lab.idProtocolo, lab))" />
                    }
                }
            </div>
            <div id="pdffile"></div>
            <div id="load-more-sentinel" style="height: 1px;"></div>
            @if (_isLoadingMore && Model.LstMisLaboratorios != null && _loadedCount < Model.LstMisLaboratorios.Count)
            {
                <div class="text-center text-secondary my-2" aria-live="polite">Cargando…</div>
            }
        </div>
    }
    else
    {
        <EmptyState Message="No existen datos para mostrar" />
    }
</div>
