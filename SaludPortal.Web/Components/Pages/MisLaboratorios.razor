@page "/mislaboratorios"

@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using SaludPortal.Web.Components.Icons
@using SaludPortal.Web.Components.Shared
@using SaludPortal.Web.Services
@using System.Security.Claims
@using System.Text

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IConfiguration Configuration
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JSRuntime
@inject BlazorSpinner.SpinnerService _spinnerService
@inject AndesServices.Entities.ViewModels.VMMisLaboratorios Model
@inject ILogger<AndesServices.Services.MisLaboratoriosService> Logger

@inherits AuthenticatedComponentBase

<style>
    .laboratorios p {
        margin: 0px;
    }

    .laboratorios {
        cursor: pointer;
        box-shadow: 2px 2px 4px #000000;
        margin-bottom: 5px;
    }
</style>

<h1>Mis Laboratorios</h1>
<hr />
@* <div class="form-control">

    <p>Fecha desde: <InputText type="date" id="fechaDesde" @bind-value="Model.FechaDesde" aria-label="Fecha desde" /></p>

    <p>Fecha hasta: <InputText type="date" id="fechaHasta" @bind-Value="Model.FechaHasta" aria-label="Fecha hasta" /></p>

    <p><button class="btn btn-verde" @onclick="BuscarLaboratorios">Buscar</button></p> 
</div>*@
@if (Model.LstMisLaboratorios != null)
{
    @foreach (var misLaboratorios in Model.LstMisLaboratorios.OrderByDescending(l => l.fecha))
    {
        @if (misLaboratorios != null)
        {
            <div class="form-control laboratorios">
                @if (misLaboratorios.Laboratorio != null)
                {
                    <div class="d-flex justify-content-between" @onclick="@(() => DownloadLaboratorio(misLaboratorios.idProtocolo.ToString()))" title="Descargar" tabindex="0">
                        <div>
                            <p><strong>@DateTime.Parse(@misLaboratorios.fecha).ToString("dd/MM/yyyy")</strong></p>
                            <p><strong>Informe De Laboratorio</strong></p>
                            <p>
                                <Icon Name="hospital" Size="16" Fill="#fff" class="text-secondary me-1" AriaLabel="Institución" />
                                @misLaboratorios.Laboratorio
                            </p>
                            <strong>Solicitante: </strong>@misLaboratorios.medicoSolicitante
                        </div>
                        <div class="align-content-center">
                            <Icon Name="cloud-download" Size="32" Fill="#fff" class="text-secondary me-1" AriaLabel="Descargar" />
                        </div>
                    </div>
                }
            </div>
        }
    }
    <div id="pdffile"></div>
}
else
{
    <label>No existen datos para mostrar</label>
}
@* <h2>Instituciones privadas</h2> *@
@if (Model.LstLaboratoriosLachybs != null)
{
    @foreach (var misLaboratorios in Model.LstLaboratoriosLachybs)
    {
        @if (misLaboratorios != null)
        {
            <div class="form-control laboratorios">
                <div class="d-flex justify-content-between" @onclick="@(() => DownloadLaboratorioLACHyBS(misLaboratorios.protocolo_id.ToString()))" title="Descargar" tabindex="0">
                    <div>
                        @* <p><strong>@DateTime.Parse(@misLaboratorios.fecha).ToString("dd/MM/yyyy")</strong></p> *@
                        <p><strong>Informe De Laboratorio</strong></p>
                        <p>
                            <Icon Name="hospital" Size="16" Fill="#fff" class="text-secondary me-1" AriaLabel="Institución" />
                            Clínica Raña
                        </p>
                        <strong>Protocolo: </strong>@misLaboratorios.protocolo
                    </div>
                    <div class="align-content-center">
                        <Icon Name="cloud-download" Size="32" Fill="#fff" class="text-secondary me-1" AriaLabel="Descargar" />
                    </div>
                </div>
            </div>
        }
    }
    <div id="pdffile"></div>
}
else
{
    @* <label>No existen datos para mostrar</label> *@
}

<script type="text/javascript">

    function openPdfLab(archivo) {
    const pdfData = "data:application/pdf;base64," + archivo;

    const a = document.createElement("a");
    document.body.appendChild(a);
    a.href = pdfData;
    a.download = "laboratorio.pdf";
    a.target = "_self";
    a.click();
    }

    // function BlazorDownloadFile(filename, contentType, content) {

    // // window.open(content);
    // const pdfData = "data:application/pdf;base64," + content;
    // var archivo = document.getElementById("pdffile");
    // archivo.innerHTML = content;
    // }
</script>

@code {
    private MisLaboratoriosService? _misLaboratoriosService;
    private Byte[] archivoDescargar = null;
    private string idProtocolo = "";
    private string archivoDescargarLACHyBS = "";

    protected async Task BuscarLaboratorios()
    {
        if (User.Identity?.IsAuthenticated != true)
        {
            var returnUrl = Nav.ToBaseRelativePath(Nav.Uri);
            Nav.NavigateTo($"/login", true);
        }

        var token = BackendToken;
        if (string.IsNullOrEmpty(token))
            return;

        var pacienteId = PacienteId;
        if (string.IsNullOrEmpty(pacienteId))
            return;

        _misLaboratoriosService = new MisLaboratoriosService(Configuration, HttpClientFactory, Logger);

        if (_misLaboratoriosService != null)
        {
            _spinnerService.Show();
            Model.LstMisLaboratorios = await _misLaboratoriosService.ObtenerMisLaboratoriosAsync(token, pacienteId, Model.FechaDesde, Model.FechaHasta);
            _spinnerService.Hide();
        }
    }

    protected override async Task OnAuthenticatedInitializedAsync()
    {
        var token = BackendToken;
        var pacienteId = PacienteId;
        var documento = Documento;
        if (string.IsNullOrEmpty(token) || string.IsNullOrEmpty(pacienteId) || string.IsNullOrEmpty(documento))
            return;

        // Model.FechaDesde = DateTime.Now.AddDays(-30).ToString("yyyy-MM-dd");
        // Model.FechaHasta = DateTime.Now.ToString("yyyy-MM-dd");
        _misLaboratoriosService = new MisLaboratoriosService(Configuration, HttpClientFactory, Logger);

        if (_misLaboratoriosService != null)
        {
            _spinnerService.Show();
            Model.LstMisLaboratorios = await _misLaboratoriosService.ObtenerMisLaboratoriosAsync(token, pacienteId, "20200101", DateTime.Now.ToString("yyyyMMdd"));
            Model.LstLaboratoriosLachybs = await _misLaboratoriosService.ObtenerMisLaboratoriosLACHYBSAsync("xroad", "sol2025", documento);
            _spinnerService.Hide();
        }
    }

    async Task DownloadLaboratorio(string idProtocolo)
    {
        _spinnerService.Show();
        _misLaboratoriosService = new MisLaboratoriosService(Configuration, HttpClientFactory, Logger);
        archivoDescargar = await _misLaboratoriosService.DescargarLaboratorio(BackendToken, idProtocolo, Documento);
        if (archivoDescargar == null || archivoDescargar.Length == 0)
        {
            _spinnerService.Hide();
            await JSRuntime.InvokeVoidAsync("alert", "No se encontró el archivo del laboratorio.");
            return;
        }

        string base64Pdf = Convert.ToBase64String(archivoDescargar);
        await JSRuntime.InvokeVoidAsync("openPdfLab", base64Pdf);
        _spinnerService.Hide();
    }

    async Task DownloadLaboratorioLACHyBS(string idProtocolo)
    {
        _spinnerService.Show();
        _misLaboratoriosService = new MisLaboratoriosService(Configuration, HttpClientFactory, Logger);
        archivoDescargarLACHyBS = await _misLaboratoriosService.DescargarLaboratorioLACHyBSPorIdAsync("xroad", "sol2025", idProtocolo);
        if (archivoDescargarLACHyBS == null || archivoDescargarLACHyBS.Length == 0)
        {
            _spinnerService.Hide();
            await JSRuntime.InvokeVoidAsync("alert", "No se encontró el archivo del laboratorio.");
            return;
        }

        if (!string.IsNullOrEmpty(archivoDescargarLACHyBS))
            await JSRuntime.InvokeVoidAsync("open", archivoDescargarLACHyBS, "_blank");
            // Nav.NavigateTo(archivoDescargarLACHyBS, true);

        // string base64Pdf = Convert.ToBase64String(archivoDescargar);
        // await JSRuntime.InvokeVoidAsync("openPdfLab", base64Pdf);
        _spinnerService.Hide();
    }
}