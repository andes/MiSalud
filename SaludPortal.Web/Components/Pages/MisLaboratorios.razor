<script type="text/javascript">

    function openPdfLab(archivo) {
    const pdfData = "data:application/pdf;base64," + archivo;

    const a = document.createElement("a");
    document.body.appendChild(a);
    a.href = pdfData;
    a.download = "laboratorio.pdf";
    a.target = "_self";
    a.click();
    }

    window.InfiniteScroll = {
        observer: null,
        observe: function (elementId, dotnetRef, callback) {
            const el = document.getElementById(elementId);
            if (!el) return;

            if (this.observer) {
                this.observer.disconnect();
                this.observer = null;
            }

            const options = { root: null, rootMargin: '0px', threshold: 0.1 };
            let ticking = false;

            this.observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        if (ticking) return;
                        ticking = true;
                        setTimeout(() => {
                            dotnetRef.invokeMethodAsync(callback).catch(() => { });
                            ticking = false;
                        }, 100);
                    }
                });
            }, options);

            this.observer.observe(el);
        },
        unobserve: function (elementId) {
            if (this.observer) {
                const el = document.getElementById(elementId);
                if (el) this.observer.unobserve(el);
                this.observer.disconnect();
                this.observer = null;
            }
        }
    };
</script>

@code {
    private Byte[] archivoDescargar = null;
    private string idProtocolo = "";
    private string archivoDescargarLACHyBS = "";

    // Estado de paginación en cliente (infinite scroll)
    private List<AndesServices.Entities.MisLaboratorios> _visibleLabs = new();
    private int _pageSize = 20;
    private int _loadedCount = 0;
    private bool _isLoadingMore = false;
    private DotNetObjectReference<MisLaboratorios>? _dotNetRef;
    private bool _observerAttached = false;

    protected async Task BuscarLaboratorios()
    {
        if (User.Identity?.IsAuthenticated != true)
        {
            var returnUrl = Nav.ToBaseRelativePath(Nav.Uri);
            Nav.NavigateTo($"/login", true);
        }

        var token = BackendToken;
        if (string.IsNullOrEmpty(token))
            return;

        var pacienteId = PacienteId;
        if (string.IsNullOrEmpty(pacienteId))
            return;

        _spinnerService.Show();
        Model.LstMisLaboratorios = await _misLaboratoriosService.ObtenerMisLaboratoriosAsync(pacienteId, Model.FechaDesde, Model.FechaHasta);
        _spinnerService.Hide();
    }

    protected override async Task OnAuthenticatedInitializedAsync()
    {
        var token = BackendToken;
        var pacienteId = PacienteId;
        var documento = Documento;
        if (string.IsNullOrEmpty(token) || string.IsNullOrEmpty(pacienteId) || string.IsNullOrEmpty(documento))
            return;

        string fechaDesde = DateTime.Now.AddYears(SaludConfiguracion.fechaDesde * (-1)).ToString("yyyyMMdd");

        // Mis Laboratorios
        _spinnerService.Show();
        Model.LstMisLaboratorios = await _misLaboratoriosService.ObtenerMisLaboratoriosAsync(pacienteId, fechaDesde, DateTime.Now.ToString("yyyyMMdd"));

        var cfg = new ConexionServicios();
        Configuration.GetSection("urlServicios").Bind(cfg);

        // Mis Laboratorios CDA
        Model.LstMisLaboratoriosCDA = await _misLaboratoriosService.ObtenerMisLaboratoriosCDAAsync(pacienteId, fechaDesde, DateTime.Now.ToString("yyyyMMdd"));

        if (Model.LstMisLaboratoriosCDA.Count() > 0)
        {
            foreach (var item in Model.LstMisLaboratoriosCDA.Where(c => c?.prestacion?.snomed?.conceptId == "4241000179101"))
            {
                AndesServices.Entities.MisLaboratorios unLaboratorio = new AndesServices.Entities.MisLaboratorios();
                unLaboratorio.Laboratorio = item.organizacion.nombre;
                unLaboratorio.medicoSolicitante = item.profesional.apellido + " " + item.profesional.nombre;
                unLaboratorio.fecha = item.fecha.ToString("dd/MM/yyyy");
                unLaboratorio.idProtocolo = item.cda_id;
                unLaboratorio.tipo = "cda";

                Model.LstMisLaboratorios.Add(unLaboratorio);
            }
        }

        // Mis Laboratorios Raña
        var protocolosRania = await _misLaboratoriosService.ObtenerProtocolosRania(documento);

        foreach (var protocolo in protocolosRania)
        {
            var unLaboratorio = new AndesServices.Entities.MisLaboratorios();
            unLaboratorio.Laboratorio = "Clínica Dr. Roberto Raña";
            unLaboratorio.medicoSolicitante = $"{protocolo.SolicitanteApellido} {protocolo.SolicitanteNombre}";
            unLaboratorio.fecha = protocolo.Fecha;
            unLaboratorio.idProtocolo = protocolo.ProtocoloId;
            unLaboratorio.tipo = "raña";

            if (Model.LstMisLaboratorios == null)
            {
                Model.LstMisLaboratorios = new List<AndesServices.Entities.MisLaboratorios>();
            }
            Model.LstMisLaboratorios.Add(unLaboratorio);
        }

        _spinnerService.Hide();

        await ResetAndInitVisibleAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await EnsureObserverAsync();
        }
    }

    [JSInvokable]
    public async Task OnLoadMore()
    {
        await LoadMoreAsync();
    }

    private async Task ResetAndInitVisibleAsync()
    {
        // Tamaño de página configurable
        _pageSize = SaludConfiguracion.misLaboratoriosPageSize > 0 ? SaludConfiguracion.misLaboratoriosPageSize : 20;

        // Ordenamos una sola vez para no ordenar en cada render
        if (Model.LstMisLaboratorios != null)
        {
            // Las fechas ya vienen en formato dd/MM/yyyy desde el servicio
            // Ordenamos parseando las fechas de forma segura
            Model.LstMisLaboratorios = Model.LstMisLaboratorios.OrderByDescending(l =>
            {
                if (string.IsNullOrEmpty(l.fecha))
                    return DateTime.MinValue;

                if (DateTime.TryParseExact(l.fecha, "dd/MM/yyyy",
                    System.Globalization.CultureInfo.InvariantCulture,
                    System.Globalization.DateTimeStyles.None, out DateTime result))
                {
                    return result;
                }

                return DateTime.MinValue;
            }).ToList();
        }

        _visibleLabs.Clear();
        _loadedCount = 0;

        await LoadMoreAsync(reset: true);
        await EnsureObserverAsync();
        StateHasChanged();
    }

    private async Task EnsureObserverAsync()
    {
        if (!_observerAttached && Model.LstMisLaboratorios != null && _loadedCount < Model.LstMisLaboratorios.Count && _dotNetRef is not null)
        {
            await JSRuntime.InvokeVoidAsync("InfiniteScroll.observe", "load-more-sentinel", _dotNetRef, "OnLoadMore");
            _observerAttached = true;
        }
        else if (Model.LstMisLaboratorios != null && _loadedCount >= Model.LstMisLaboratorios.Count)
        {
            await JSRuntime.InvokeVoidAsync("InfiniteScroll.unobserve", "load-more-sentinel");
            _observerAttached = false;
        }
    }

    private async Task LoadMoreAsync(bool reset = false)
    {
        if (Model.LstMisLaboratorios == null) return;
        if (_isLoadingMore) return;

        _isLoadingMore = true;
        try
        {
            var total = Model.LstMisLaboratorios.Count;
            var remaining = total - _loadedCount;

            // Si ya no queda nada, desactivar el observer y salir
            if (remaining <= 0)
            {
                if (_observerAttached)
                {
                    try
                    {
                        await JSRuntime.InvokeVoidAsync("InfiniteScroll.unobserve", "load-more-sentinel");
                    }
                    catch { /* ignorar errores de JS */ }
                    _observerAttached = false;
                }
                return;
            }

            var toTake = Math.Min(_pageSize, remaining);
            if (toTake > 0)
            {
                _visibleLabs.AddRange(Model.LstMisLaboratorios.Skip(_loadedCount).Take(toTake));
                _loadedCount += toTake;
            }

            if (_loadedCount >= total && _observerAttached)
            {
                try
                {
                    await JSRuntime.InvokeVoidAsync("InfiniteScroll.unobserve", "load-more-sentinel");
                }
                catch { /* ignorar errores de JS */ }
                _observerAttached = false;
            }
        }
        catch (Exception ex)
        {
            Logger?.LogError(ex, "Error en LoadMoreAsync");
        }
        finally
        {
            _isLoadingMore = false;
            StateHasChanged(); // asegura refresco del UI aunque no se hayan agregado ítems
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("InfiniteScroll.unobserve", "load-more-sentinel");
        }
        catch { /* ignore if JS not available */ }
        _dotNetRef?.Dispose();
    }

    async Task DownloadLaboratorio(string idProtocolo, AndesServices.Entities.MisLaboratorios unLaboratorio)
    {
        _spinnerService.Show();
        switch (unLaboratorio.tipo)
        {
            case "raña":
                var archivo = await _misLaboratoriosService.DescargarInformeRaniaPorIdAsync(idProtocolo);
                if (archivo == null || archivo.Length == 0)
                {
                    _spinnerService.Hide();
                    await JSRuntime.InvokeVoidAsync("alert", "No se encontró el archivo del laboratorio.");
                    return;
                }

                await JSRuntime.InvokeVoidAsync("openPdfLab", Convert.ToBase64String(archivo));

                break;
            case "cda":

                string laboratorioAdjunto = Model.LstMisLaboratoriosCDA.Where(c => c.cda_id == unLaboratorio.idProtocolo).Select(c => c.adjuntos[0]).FirstOrDefault();
                laboratorioAdjunto = laboratorioAdjunto.Substring(laboratorioAdjunto.LastIndexOf('/') + 1);
                laboratorioAdjunto = laboratorioAdjunto.Substring(0, laboratorioAdjunto.LastIndexOf('.'));
                archivoDescargar = await _misLaboratoriosService.DescargarLaboratorioCDAPorIdAsync(laboratorioAdjunto);

                string base64Pdf_CDA = Convert.ToBase64String(archivoDescargar);
                await JSRuntime.InvokeVoidAsync("openPdfLab", base64Pdf_CDA);

                break;

            default: //rup
                archivoDescargar = await _misLaboratoriosService.DescargarLaboratorioPorIdAsync(idProtocolo, Documento);
                if (archivoDescargar == null || archivoDescargar.Length == 0)
                {
                    _spinnerService.Hide();
                    await JSRuntime.InvokeVoidAsync("alert", "No se encontró el archivo del laboratorio.");
                    return;
                }

                string base64Pdf = Convert.ToBase64String(archivoDescargar);
                await JSRuntime.InvokeVoidAsync("openPdfLab", base64Pdf);
                break;
        }
        // if (laboratorio == "CLÍNICA RAÑA")
