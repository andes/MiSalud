@page "/turnosmensajecancelado"
@rendermode InteractiveServer

@using AndesServices.Entities
@using SaludPortal.Web.Components.Shared
@using SaludPortal.Web.Components.Icons
@inject MessageService MessageService

<PageTitle>Turno cancelado - Mi Salud</PageTitle>

<div class="turnos-mensaje-container">
    <div class="turnos-mensaje-header">
        <PageHeader Title="Mis turnos" />
        <div class="turnos-mensaje-header__back">
            <ButtonPrimaryOutlined Href="/misturnos" Text="Volver a mis turnos" AriaLabel="Volver a mis turnos"
                                   Size="sm" />
        </div>
    </div>

    <div class="turnos-mensaje-card turnos-mensaje-warning">
        <div class="turnos-mensaje-icon-wrapper">
            <Icon Name="x-circle" Size="64" Fill="#dc3545" AriaLabel="Cancelado" />
        </div>
        <div class="turnos-mensaje-content">
            <h2 class="turnos-mensaje-title">@MessageService.Title</h2>
            @if (!string.IsNullOrWhiteSpace(MessageService.Content))
            {
                <div class="turnos-mensaje-body">
                    <p>@MessageService.Content</p>
                </div>
            }
        </div>
    </div>
</div>