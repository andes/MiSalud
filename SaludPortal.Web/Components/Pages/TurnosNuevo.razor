@page "/turnosnuevo"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Authorization
@using SaludPortal.Web.Components.Modals
@using SaludPortal.Web.Components.Shared
@using SaludPortal.Web.Components.Icons
@using SaludPortal.Web.Services
@using AndesServices.Interfaces
@using System.Security.Claims
@using AndesServices.Entities
@using System.Linq

@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject BlazorSpinner.SpinnerService _spinnerService
@inject IPaciente _unPacienteService
@inject IMisTurnos _misTurnosService
@inject IOrganizacion _organizacionService

@inherits AuthenticatedComponentBase

<PageTitle>Nuevo turno - Mi Salud</PageTitle>

<div class="turnos-nuevo-container">
    <PageHeaderWithBack Title="Nuevo turno"
                        Subtitle="Agendas disponibles"
                        BackHref="/misturnos"
                        BackAriaLabel="Volver al Mis Turnos" />

    @if (lstAgendas != null && lstAgendas.Count > 0)
    {
        var tipoPrestacionIndex = 0;
        var tipoPrestacioness = ObtenerTipoPrestacionesDisponibles().ToList();
        var hayMasDeUnTipo = tipoPrestacioness.Count > 1;
        <div class="turnos-nuevo-accordion" id="accAgendas">

            @foreach (var tipoPrestaciones in tipoPrestacioness )
            {
                var tipoId = $"TipoPrestacion_{tipoPrestacionIndex}";
                var collapseTipoId = $"collapse_{tipoPrestacionIndex}";
                var efectores = ObtenerEfectores(tipoPrestaciones.id);
                var isExpanded = !hayMasDeUnTipo;

                tipoPrestacionIndex++;
                <div class="turnos-nuevo-accordion-item">
                    <h2 class="turnos-nuevo-accordion-header" id="@tipoId">
                        <button class="turnos-nuevo-accordion-button @(isExpanded ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseTipoId" aria-expanded="@(isExpanded ? "true" : "false")" aria-controls="@collapseTipoId">
                            <Icon Name="calendar-check" Size="20" Fill="#87b867" class="me-2" AriaLabel="Prestación" />
                            @tipoPrestaciones.term
                        </button>
                    </h2>
                    <div id="@collapseTipoId" class="turnos-nuevo-accordion-collapse collapse @(isExpanded ? "show" : "")" aria-labelledby="@tipoId" data-bs-parent="#accAgendas">
                        <div class="turnos-nuevo-accordion-body">
                            <div class="turnos-nuevo-efectores-list">
                                
                                @foreach (var efector in efectores)
                                {
                                    var efectorId = efector.Efector._id;
                                    var turnosAgrupados = ObtenerTurnosAgrupadosPorFecha(tipoPrestaciones.id, efectorId);
                                    <EfectorCard EfectorNombre="@efector.Efector.nombre" Domicilio="@efector.Domicilio">
                                        @if (turnosAgrupados.Any())
                                        {
                                            <TurnoHorarioGrid TurnosPorFecha="@turnosAgrupados" 
                                                               OnTurnoSeleccionado="@(async (turno) => await HandleTurnoSeleccionado(turno, tipoPrestaciones.term, efector.Efector.nombre, efector.Domicilio, tipoPrestaciones.id, efectorId))" />
                                        }
                                    </EfectorCard>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <EmptyState Message="No hay turnos disponibles." />
    }
</div>

@code {
    private List<OrganizacionAgenda> lstAgendas = new List<OrganizacionAgenda>();
    private Paciente? _unPaciente = new Paciente();
    private Direccion _direccionGeoreferencia = new Direccion();
    private userLocation _userLocation = new userLocation();
    private int itemForeachtipoPrestaciones;
    private int itemForeachOrganizaciones;
    private Organizacion organizacion = new Organizacion();
    private Dictionary<string, string> _domiciliosOrganizaciones = new();

    [CascadingParameter] IModalService Modal { get; set; } = default!;

    private async Task ShowModalConfirmar(DateTime Fecha, DateTime Hora, string TipoPrestacion, string Efector, string EfectorDomicilio, string IdTipoPrestacion, string IdTurno, string IdBloque)
    {
        var options = new ModalOptions()
        {
            Size = ModalSize.Automatic,
            Position = ModalPosition.TopCenter,
            HideCloseButton = true,
            HideHeader = true
        };

        var parameters = new ModalParameters()
        .Add(nameof(TurnoNuevoConfirmar.Paciente), _unPaciente?.GetDisplayName())
        .Add(nameof(TurnoNuevoConfirmar.FechaHoraTurno), Fecha.ToString("dd/MM/yyyy") + " " + Hora.ToString("HH:mm"))
        .Add(nameof(TurnoNuevoConfirmar.TipoPrestacion), TipoPrestacion)
        .Add(nameof(TurnoNuevoConfirmar.EfectorNombre), Efector)
        .Add(nameof(TurnoNuevoConfirmar.EfectorDomicilio), EfectorDomicilio)
        .Add(nameof(TurnoNuevoConfirmar.IdTurno), IdTurno)
        .Add(nameof(TurnoNuevoConfirmar.IdBloque), IdBloque)
        .Add(nameof(TurnoNuevoConfirmar.IdAgenda), ObtenerAgendaPorIdBloque(IdBloque)._id)
        .Add(nameof(TurnoNuevoConfirmar._unTipoPrestacion), ObtenerTipoPrestacionesDisponibles(IdTipoPrestacion));

        Modal.Show<TurnoNuevoConfirmar>(parameters, options);
    }

    protected override async Task OnAuthenticatedInitializedAsync()
    {
        var token = BackendToken;
        if (string.IsNullOrEmpty(token))
            return;

        var pacienteId = PacienteId;
        if (string.IsNullOrEmpty(pacienteId))
            return;

        _spinnerService.Show();

        try
        {
            // Obtengo el paciente
            _unPaciente = await _unPacienteService.ObtenerPacientePorIdAsync(pacienteId);

            // Verifico que domicilio utilizar para referencia a las organizaciones
            _direccionGeoreferencia = _unPacienteService.ObtenerDireccionPrioritaria(_unPaciente);
            if (_direccionGeoreferencia == null) return;

            if (_direccionGeoreferencia.valor == null || _direccionGeoreferencia.ubicacion.localidad == null || _direccionGeoreferencia.ubicacion.provincia == null)
            {
                return;
            }
            string direccion = _direccionGeoreferencia.valor + ", " + _direccionGeoreferencia.ubicacion.localidad.nombre + ", " + _direccionGeoreferencia.ubicacion.provincia.nombre;
            _userLocation = await _unPacienteService.ObtenerGeoreferenciaPaciente(direccion);

            if (_userLocation != null)
            {
                lstAgendas = await _misTurnosService.ObtenerAgendasOrganizaciones(pacienteId, _userLocation, esTeleconsulta: false);

                // Obtener todos los IDs de organizaciones únicos
                var orgIds = lstAgendas
                    .SelectMany(e => e.agendas)
                    .Select(a => a.organizacion._id)
                    .Distinct()
                    .ToList();

                // Llamar a ObtenerOrganizacionPorIdAsync para cada organización y guardar el domicilio
                foreach (var orgId in orgIds)
                {
                    var organizacion = await _organizacionService.ObtenerOrganizacionPorIdAsync(orgId);
                    if (organizacion != null && !_domiciliosOrganizaciones.ContainsKey(orgId))
                    {
                        // Asume que organizacion.direccion?.valor es el domicilio
                        _domiciliosOrganizaciones[orgId] = organizacion.direccion?.valor ?? "";
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _spinnerService.Hide();
        }
    }

    private IEnumerable<(string term, string id)> ObtenerTipoPrestacionesDisponibles()
    {
        return lstAgendas?
        .SelectMany(e => e.agendas)
        .Where(a => a.bloques != null && a.bloques.Count > 0 && a.bloques.Any(b => b.restantesMobile > 0))
        .SelectMany(a => (a.tipoPrestaciones ?? new List<TipoPrestacion>()))
        .Where(tp => !string.IsNullOrWhiteSpace(tp.term))
        .Select(tp => (term: tp.term, id: tp._id))
        .Distinct()
        .OrderBy(t => t)
        ?? Enumerable.Empty<(string, string)>();
    }

    private TipoPrestacion? ObtenerTipoPrestacionesDisponibles(string id)
    {
        return lstAgendas?
            .SelectMany(e => e.agendas)
            .Where(a => a.bloques != null && a.bloques.Count > 0 && a.bloques.Any(b => b.restantesMobile > 0))
            .SelectMany(a => a.tipoPrestaciones ?? new List<TipoPrestacion>())
            .FirstOrDefault(tp => tp._id == id);
    }

    private Agenda? ObtenerAgendaPorIdBloque(string idBloque)
    {
        return lstAgendas?
            .SelectMany(org => org.agendas ?? new List<Agenda>())
            .FirstOrDefault(agenda =>
                agenda.bloques != null &&
                agenda.bloques.Any(bloque => bloque._id == idBloque)
            );
    }

    private IEnumerable<(AgendaOrganizacion Efector, string Domicilio)> ObtenerEfectores(string _idTipoPrestacion)
    {
        return lstAgendas?
            .SelectMany(e => e.agendas
                .Where(a => a.bloques != null && a.bloques.Any(b => b.restantesMobile > 0))
                .Where(a => (a.tipoPrestaciones ?? new List<TipoPrestacion>())
                    .Any(tp => tp!._id == _idTipoPrestacion))
                .Select(a => (
                    a.organizacion,
                    _domiciliosOrganizaciones.TryGetValue(a.organizacion._id, out var domicilio) ? domicilio : ""
                ))
            )
            .Where(x => x.organizacion != null)
            .DistinctBy(x => x.organizacion!._id)
            ?? Enumerable.Empty<(AgendaOrganizacion, string)>();
    }

    private IEnumerable<Bloque> RecuperarAgendas(string _idTipoPrestacion, string Efector)
    {
        return lstAgendas?
            .SelectMany(e => e.agendas
                    .Where(a =>
                a.bloques != null
                && a.organizacion?._id == Efector
                && (a.tipoPrestaciones ?? new List<TipoPrestacion>())
                    .Any(tp => tp._id == _idTipoPrestacion)
                && a.bloques.Any(b =>
                    b.restantesMobile > 0
                    && b.turnos.Any(c => c.estado == "disponible")
                )
            )
            .SelectMany(a => a.bloques
                .Where(b =>
                    b.restantesMobile > 0
                    && b.turnos.Any(c => c.estado == "disponible")
                )
            )
        )
        ?? Enumerable.Empty<Bloque>();
    }

    private List<TurnoHorarioGrid.TurnoFechaGrupo> ObtenerTurnosAgrupadosPorFecha(string tipoPrestacionId, string efectorId)
    {
        var grupos = new List<TurnoHorarioGrid.TurnoFechaGrupo>();
        var bloques = RecuperarAgendas(tipoPrestacionId, efectorId).ToList();

        foreach (var bloque in bloques)
        {
            var turnosDisponibles = bloque.turnos?
                .Where(t => t.estado == "disponible")
                .ToList() ?? new List<MisTurnos>();

            if (!turnosDisponibles.Any())
                continue;

            var turnosPorFecha = turnosDisponibles
                .GroupBy(t => t.horaInicio.Date)
                .OrderBy(g => g.Key);

            foreach (var grupoFecha in turnosPorFecha)
            {
                var fechaGrupo = grupos.FirstOrDefault(g => g.Fecha.Date == grupoFecha.Key.Date);
                if (fechaGrupo == null)
                {
                    fechaGrupo = new TurnoHorarioGrid.TurnoFechaGrupo
                    {
                        Fecha = grupoFecha.Key,
                        Disponibles = bloque.restantesMobile,
                        Turnos = new List<MisTurnos>()
                    };
                    grupos.Add(fechaGrupo);
                }

                fechaGrupo.Turnos.AddRange(grupoFecha.OrderBy(t => t.horaInicio));
            }
        }

        return grupos.OrderBy(g => g.Fecha).ToList();
    }

    private async Task HandleTurnoSeleccionado(MisTurnos turno, string tipoPrestacion, string efectorNombre, string efectorDomicilio, string tipoPrestacionId, string efectorId)
    {
        // Encontrar el bloque que contiene este turno
        var bloques = RecuperarAgendas(tipoPrestacionId, efectorId).ToList();
        var bloqueEncontrado = bloques.FirstOrDefault(b => b.turnos?.Any(t => t._id == turno._id) == true);

        if (bloqueEncontrado != null)
        {
            var fecha = turno.horaInicio.Date;
            var hora = DateTimeHelper.ToArgentinaTime(turno.horaInicio);
            await ShowModalConfirmar(fecha, hora, tipoPrestacion, efectorNombre, efectorDomicilio, tipoPrestacionId, turno._id, bloqueEncontrado._id);
        }
    }
}
