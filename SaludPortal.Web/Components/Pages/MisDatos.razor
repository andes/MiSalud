@page "/mis-datos"
@page "/misdatos"

@using Microsoft.AspNetCore.Components.Authorization
@using SaludPortal.Web.Components.Icons
@using SaludPortal.Web.Components.Shared
@using SaludPortal.Web.Services
@using AndesServices.Interfaces
@using AndesServices.Entities
@using Newtonsoft.Json

@inherits AuthenticatedComponentBase

@inject BlazorSpinner.SpinnerService _spinnerService
@inject IPaciente _pacienteService
@inject ITerritorio _territorioService

<PageTitle>Mis Datos</PageTitle>

<div class="mis-datos-container p-4">
    @if (_paciente != null)
    {
        <div class="row g-4">
            <div class="col-12 col-lg-6">
                <div class="section-container h-100">
                    <div class="section-header d-flex align-items-center gap-3 p-3">
                        <Icon Name="mis-datos" Size="42" />
                        <div class="flex-grow-1">
                            <h2 class="section-title mb-0 fw-bold">Datos Personales</h2>
                            <div class="text-white-100 small">
                                @(_paciente.apellido?.Trim() + ", " + _paciente.nombre?.Trim())
                            </div>
                        </div>
                    </div>
                    <div class="section-content p-4">
                        <div class="mb-3">
                            <label for="alias" class="form-label fw-semibold">Nombre Autopercibido</label>
                            <InputText id="alias" class="form-control" @bind-Value="_paciente.alias" placeholder="¿Cómo querés ser llamado por tu equipo médico?" />
                        </div>
                        <div class="mb-3">
                            <label for="genero" class="form-label fw-semibold">Género</label>
                            <InputSelect id="genero" class="form-select" @bind-Value="_paciente.genero">
                                <option value="">Seleccione un género</option>
                                @foreach (var genero in _generosPermitidos)
                                {
                                    <option value="@genero">@genero</option>
                                }
                            </InputSelect>
                        </div>
                        @if (!string.IsNullOrEmpty(_paciente.documento))
                        {
                            <div class="mb-3">
                                <label for="documento" class="form-label fw-semibold">Documento</label>
                                <InputText id="documento" class="form-control" @bind-Value="_paciente.documento" readonly aria-readonly="true" />
                            </div>
                        }
                        @if (_paciente.fechaNacimiento.HasValue)
                        {
                            <div class="mb-3">
                                <label for="fechaNacimiento" class="form-label fw-semibold">Fecha de nacimiento</label>
                                <InputDate id="fechaNacimiento" class="form-control" @bind-Value="_paciente.fechaNacimiento" readonly aria-readonly="true" />
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-6">
                @if (_direccionSeleccionada != null)
                {
                    <div class="section-container">
                        <div class="section-header d-flex align-items-center gap-3 p-3">
                            <i class="bi bi-house-door-fill" aria-hidden="true"></i>
                            <h2 class="section-title mb-0 fw-bold flex-grow-1">Domicilio</h2>
                        </div>
                        <div class="section-content p-4">
                            <div class="mb-3">
                                <label for="provincia" class="form-label fw-semibold">Provincia</label>
                                <InputSelect id="provincia" class="form-select" @bind-Value="_provinciaSeleccionadaId" @bind-Value:after="OnProvinciaChanged" aria-describedby="@(!string.IsNullOrEmpty(_errorProvincia) ? "error-provincia" : null)">
                                    <option value="">Seleccione una provincia</option>
                                    @foreach (var provincia in _provincias)
                                    {
                                        <option value="@(provincia.id ?? provincia._id)">@provincia.nombre</option>
                                    }
                                </InputSelect>
                                @if (!string.IsNullOrEmpty(_errorProvincia))
                                {
                                    <div id="error-provincia" class="text-danger small mt-1" role="alert" aria-live="polite">@_errorProvincia</div>
                                }
                            </div>
                            <div class="mb-3">
                                <label for="localidad" class="form-label fw-semibold">Localidad</label>
                                <InputSelect id="localidad" class="form-select" @bind-Value="_localidadSeleccionadaId" @bind-Value:after="OnLocalidadChanged" disabled="@(_localidades == null || !_localidades.Any() || _cargandoLocalidades)" aria-describedby="@(_cargandoLocalidades ? "loading-localidades" : (!string.IsNullOrEmpty(_errorLocalidad) ? "error-localidad" : null))">
                                    <option value="">Seleccione una localidad</option>
                                    @if (_localidades != null)
                                    {
                                        @foreach (var localidad in _localidades)
                                        {
                                            <option value="@(localidad.id ?? localidad._id)">@localidad.nombre</option>
                                        }
                                    }
                                </InputSelect>
                                @if (_cargandoLocalidades)
                                {
                                    <div id="loading-localidades" class="text-muted small mt-1 d-flex align-items-center gap-2" aria-live="polite">
                                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                        <span>Cargando localidades...</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(_errorLocalidad))
                                {
                                    <div id="error-localidad" class="text-danger small mt-1" role="alert" aria-live="polite">@_errorLocalidad</div>
                                }
                            </div>
                            <div class="mb-3">
                                <label for="direccion" class="form-label fw-semibold">Dirección</label>
                                <InputText id="direccion" class="form-control" @bind-Value="_direccionSeleccionada.valor" />
                            </div>
                            <div class="mb-3">
                                <label for="codigopostal" class="form-label fw-semibold">Código Postal</label>
                                <InputText id="codigopostal" class="form-control" @bind-Value="_direccionSeleccionada.codigoPostal" @bind-Value:after="OnCodigoPostalChanged" aria-describedby="@(!string.IsNullOrEmpty(_errorCodigoPostal) ? "error-codigopostal" : null)" />
                                @if (!string.IsNullOrEmpty(_errorCodigoPostal))
                                {
                                    <div id="error-codigopostal" class="text-danger small mt-1" role="alert" aria-live="polite">@_errorCodigoPostal</div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="row g-4 mt-2">
            <!-- Sección 3: Contacto -->
            @if (_paciente.contacto != null && _paciente.contacto.Any())
            {
                var email = _paciente.contacto.FirstOrDefault(c => c.tipo == "email");
                var celular = _paciente.contacto.FirstOrDefault(c => c.tipo == "celular");

                <div class="col">
                    <div class="section-container">
                        <div class="section-header d-flex align-items-center gap-3 p-3">
                            <i class="bi bi-phone-fill" aria-hidden="true"></i>
                            <h2 class="section-title mb-0 fw-bold flex-grow-1">Contacto</h2>
                        </div>
                        <div class="section-content p-4">
                            @if (email != null)
                            {
                                var contactoId = $"contacto-{email.tipo}";
                                <div class="mb-3">
                                    <label for="@contactoId" class="form-label fw-semibold text-capitalize">@email.tipo</label>
                                    <InputText id="@contactoId" class="form-control" @bind-Value="email.valor" />
                                </div>
                            }
                            @if (celular != null)
                            {
                                var contactoId = $"contacto-{celular.tipo}";
                                <div class="mb-3">
                                    <label for="@contactoId" class="form-label fw-semibold text-capitalize">@celular.tipo</label>
                                    <InputText id="@contactoId" class="form-control" @bind-Value="celular.valor" />
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Botones de acción -->
        <div class="d-flex gap-2 justify-content-end mt-4">
            <button class="btn btn-primary px-5" type="button" @onclick="OnActualizarDatosClick" aria-label="Actualizar datos del paciente">Actualizar datos</button>
            <button class="btn btn-danger px-5" type="button" @onclick="OnCancelarClick" aria-label="Cancelar cambios y restaurar datos originales">Cancelar</button>
        </div>
    }
</div>
